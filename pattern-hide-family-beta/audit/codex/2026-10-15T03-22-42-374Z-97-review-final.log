120:   private loadRoom(): void {
121:     const saved = this.deps.load(this.room);
122:     const chars = new Set(this.deps.chars());
123:     const items = new Set(this.deps.items().map((i) => i.id));
124:     const owners = ownerRooms(this.deps.allLayouts());
125:     const usable = (p: Placed) => {
126:       const [k, id] = p.ref.split(':');
127:       // 同じ友だち・物が ほかの部屋にもあるとき（以前の保存データ）は、先に並ぶ部屋の方だけ
128:       const owner = owners.get(p.ref);
129:       if (owner && owner !== this.room) return false;
130:       return k === 'char' ? chars.has(id as CharacterId) : items.has(id);
131:     };
132:     const base = saved ?? starterLayout(this.room);
133:     // 使えなくなったもの（パック外など）は出さない。座っている先が消えたら床に下ろす
134:     const keep = base.map((p, i) => ({ p, i })).filter(({ p }) => usable(p));
135:     const map = new Map(keep.map(({ i }, j) => [i, j]));
136:     this.list = keep.map(({ p }) => {
137:       const q: Placed = { ...p };
138:       if (q.on) {
139:         const ni = map.get(q.on.idx);
140:         if (ni === undefined) delete q.on;
141:         else q.on = { idx: ni, seat: q.on.seat };
142:       }
143:       return q;
144:     });
145:     if (!saved) this.persist();
146:   }
