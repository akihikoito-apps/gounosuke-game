130: export interface ProgressLike {
131:   cleared: number;
132:   totalFinds: number;
133:   sceneFinds?: Partial<Record<SceneId, number>>;
134: }
135: 
136: /** いま使える もの（シールを持っていて、そのシールのパックも遊べる） */
137: export function ownedItems(p: ProgressLike, can: CanPlay): ItemDef[] {
138:   return ITEMS.filter((it) => {
139:     if (!it.sticker) return !it.content || can(it.content);
140:     const s = STICKERS.find((x) => x.id === it.sticker);
141:     if (!s || !can(`char:${s.char}`)) return false;
142:     if (s.kind === 'course' && !can(`course:${s.need}`)) return false;
143:     if (s.kind === 'scene' && s.scene && !can(`scene:${s.scene}`)) return false;
144:     return hasSticker(s, p.cleared, p.totalFinds, p.sceneFinds);
145:   });
146: }
147: 
148: /** シールでもらえる もの（シールちょう・ごほうびの告知で使う） */
149: export function itemForSticker(stickerId: string): ItemDef | undefined {
150:   return ITEMS.find((i) => i.sticker === stickerId);
151: }
152: 
153: export function openRooms(cleared: number, can: CanPlay, sceneFinds: Partial<Record<SceneId, number>> = {}): RoomDef[] {
154:   return ROOMS.filter((r) => can(r.content) && cleared >= r.needCleared && (!r.needScene || (sceneFinds[r.needScene] ?? 0) >= 1));
155: }
156: 
157: /** 置いてある部屋（同じ友だち・物は1つの部屋にだけ置ける。先に並ぶ部屋が優先） */
158: export function ownerRooms(layouts: RoomLayouts): Map<string, RoomId> {
159:   const m = new Map<string, RoomId>();
160:   for (const r of ROOMS) for (const p of layouts[r.id] ?? []) if (!m.has(p.ref)) m.set(p.ref, r.id);
161:   return m;
162: }
