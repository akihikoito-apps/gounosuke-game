+const shadow = (x,y,w) => ell(x,y,w,10,g('shadow'));
+const hilite = d => path(d,'none','stroke="#FFFCED" stroke-width="2" stroke-opacity=".7" stroke-linecap="round"');
+const grain = d => path(d,'none','stroke="#88654D" stroke-opacity=".3" stroke-width="1.3" stroke-linecap="round"');
+const group = (x,y,content,s=1) => `<g transform="translate(${x} ${y}) scale(${s})">${content}</g>`;
+function bucket(x,y,w=120,h=80,color='blue') {
+  return group(x,y,shadow(0,h+2,w*.54)+path(`M${-w/2+6} 0 Q0 -40 ${w/2-6} 0`,'none',`stroke="${ink}" stroke-width="5" stroke-linecap="round"`)+path(`M${-w/2+6} 0 Q0 -40 ${w/2-6} 0`,'none','stroke="#EADCC7" stroke-width="2"')+path(`M${-w/2} 0 H${w/2} L${w/2-12} ${h} H${-w/2+12}Z`,g(color),line)+ell(0,0,w/2,9,g(color),line)+ell(0,0,w/2-7,4,'#7396A6')+hilite(`M${-w/2+12} 15 L${-w/2+21} ${h-12}`)+path(`M${-w/2+12} ${h} H${w/2-12}`,'none',`stroke="${ink}" stroke-width="3.4"`));
+}
+function stone(x,y,rx,ry) {return ell(x,y,rx,ry,g('stone'),line)+hilite(`M${x-rx*.65} ${y-ry*.32} Q${x-rx*.2} ${y-ry*.95} ${x+rx*.3} ${y-ry*.65}`);}
+function flowers(x,y,rx,ry) {
+  let out = shadow(x,y+ry,rx)+ell(x,y,rx,ry,g('leaf'),line);
+  for(const [dx,dy,c] of [[-46,-12,'cream'],[-15,-20,'pink'],[20,-9,'cream'],[48,1,'pink']]) {
+    out += path(`M${x+dx} ${y+dy+5} q3 13 -2 23`,'none','stroke="#668766" stroke-width="2"');
+    out += group(x+dx,y+dy,[-90,-18,54,126,198].map(a=>`<ellipse cy="-6" rx="5" ry="7" transform="rotate(${a})" fill="${g(c)}" stroke="#83725F" stroke-width=".8"/>`).join('')+ell(0,0,4,4,'#E4BA71'));
+  }
+  return out+path(`M${x-20} ${y+25} q-14 -18 -26 -12 q9 15 26 12 M${x+30} ${y+24} q15 -19 26 -14 q-7 15 -26 14`,'#91B88C');
+}
+function jar(x,y,w=112,h=76) {
