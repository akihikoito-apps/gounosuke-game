+const shadow = (x,y,w) => ell(x,y,w,10,g('shadow'));
+const hilite = d => path(d,'none','stroke="#FFFCED" stroke-width="2" stroke-opacity=".7" stroke-linecap="round"');
+const grain = d => path(d,'none','stroke="#88654D" stroke-opacity=".3" stroke-width="1.3" stroke-linecap="round"');
