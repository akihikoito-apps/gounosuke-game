+const ink = '#4A3A40';
+const line = `stroke="${ink}" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"`;
+const path = (d, fill='none', extra='') => `<path d="${d}" fill="${fill}" ${extra}/>`;
+const rect = (x,y,w,h,r,fill,extra='') => `<rect x="${x}" y="${y}" width="${w}" height="${h}" rx="${r}" fill="${fill}" ${extra}/>`;
+const ell = (x,y,rx,ry,fill,extra='') => `<ellipse cx="${x}" cy="${y}" rx="${rx}" ry="${ry}" fill="${fill}" ${extra}/>`;
+const grad = (id,a,b) => `<linearGradient id="${id}" x2=".85" y2="1"><stop stop-color="${a}"/><stop offset="1" stop-color="${b}"/></linearGradient>`;
+const g = id => `url(#${id})`;
