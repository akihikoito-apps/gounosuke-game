import {readFileSync} from 'node:fs';
import {chromium} from '@playwright/test';
const b=await chromium.launch();const p=await b.newPage();
for(const sid of ['garden','shop']){
 const guide=readFileSync("'`art-guides/scene-${sid}.svg`,'"'utf8');
 const faces=[...guide.matchAll(/<ellipse ["'^>]*stroke="#e00000"[''^>]*'"\\/>/g)].map(m=>Object.fromEntries([...m[0].matchAll(/(cx|cy|rx|ry)=\"(["'^"]+)"/g)].map(a=>[a[1],Number(a[2])])));
 for(const layer of ['"'over','minor','fore']){
  const data=readFileSync("'`art/scenes/${sid}/${layer}.png`).toString('"'base64');
  const result=await p.evaluate(async({data,faces})=>{const i=new Image();i.src='data:image/png;base64,'+data;await i.decode();const c=document.createElement('canvas');c.width=c.height=2000;const ctx=c.getContext('2d');ctx.drawImage(i,0,0);const px=ctx.getImageData(0,0,2000,2000).data;let count=0;for(const f of faces)for(let y=Math.floor((f.cy-f.ry)*2);y<(f.cy+f.ry)*2;y++)for(let x=Math.floor((f.cx-f.rx)*2);x<(f.cx+f.rx)*2;x++)if(((x+.5)/2-f.cx)**2/f.rx**2+((y+.5)/2-f.cy)**2/f.ry**2<=1&&px[(y*2000+x)*4+3]>0)count++;return {width:i.naturalWidth,height:i.naturalHeight,faces:faces.length,nontransparentFacePixels:count};},{data,faces});
  console.log(sid,layer,JSON.stringify(result));if(result.nontransparentFacePixels)throw Error('Face coverage');
 }
}
await b.close();
