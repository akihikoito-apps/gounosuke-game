import { describe, expect, it } from 'vitest';
import { COURSE_MOVERS, FRONT_FROM_COURSE, MOVERS, type MoverKind, moverPos, pickMovers } from '../../src/core/movers';
import { SCENES, SCENE_IDS } from '../../src/core/scenes';

// 絵の大きさのめやす（ART：art/movers の横幅、高さ）
const SIZE: Record<MoverKind, { w: number; h: number }> = {
  bird: { w: 70, h: 60 },
  seagull: { w: 90, h: 60 },
  butterfly: { w: 60, h: 60 },
  cloud: { w: 240, h: 120 },
  cat: { w: 130, h: 120 },
  puppy: { w: 120, h: 110 },
  balloon: { w: 70, h: 140 },
  sailboat: { w: 110, h: 120 },
  crab: { w: 90, h: 70 },
  ball: { w: 64, h: 64 },
};

describe('うごくもの', () => {
  it('コース1は なし、あとのコースほど増える（同じシードなら同じ）', () => {
    for (const id of SCENE_IDS) {
      expect(pickMovers(id, 1, 5)).toEqual([]);
      for (let c = 2; c <= 10; c++) {
        const ms = pickMovers(id, c, c * 13);
        expect(ms.length, `${id} course ${c}`).toBe(COURSE_MOVERS[c - 1]);
        expect(new Set(ms.map((m) => m.id)).size).toBe(ms.length);
        expect(pickMovers(id, c, c * 13)).toEqual(ms);
        // 前を通るのは コース6から
        if (c < FRONT_FROM_COURSE) expect(ms.every((m) => m.layer === 'back')).toBe(true);
        else expect(ms.some((m) => m.layer === 'front')).toBe(true);
      }
    }
  });

  it('前を通るものは、どの隠れ場所の顔も 3秒より長く隠さない', () => {
    for (const id of SCENE_IDS) {
      for (const m of MOVERS[id].filter((x) => x.layer === 'front')) {
        const { w, h } = SIZE[m.kind];
        const period = m.move === 'patrol' ? m.sec * 2 : m.sec;
        for (const sp of SCENES[id].spots) {
          const face = { x: sp.x, y: sp.y - 142 * sp.s };
          let run = 0;
          let longest = 0;
          for (let t = 0; t < period; t += 0.05) {
            const p = moverPos(m, t);
            const cover = Math.abs(face.x - p.x) < (w * m.scale) / 2 && face.y < p.y && face.y > p.y - h * m.scale;
            run = cover ? run + 0.05 : 0;
            longest = Math.max(longest, run);
          }
          expect(longest, `${m.id} × ${sp.id}`).toBeLessThan(3);
        }
      }
    }
  });

  it('前を通るものは、ときどき どこかの友だちの前を ほんとうに横切る', () => {
    for (const id of SCENE_IDS) {
      let crossings = 0;
      for (const m of MOVERS[id].filter((x) => x.layer === 'front')) {
        const { w, h } = SIZE[m.kind];
        for (const sp of SCENES[id].spots) {
          const body = { x: sp.x, y: sp.y - 80 * sp.s };
          for (let t = 0; t < m.sec * 2; t += 0.1) {
            const p = moverPos(m, t);
            if (Math.abs(body.x - p.x) < (w * m.scale) / 2 && body.y < p.y && body.y > p.y - h * m.scale) { crossings++; break; }
          }
        }
      }
      expect(crossings, id).toBeGreaterThanOrEqual(2);
    }
  });

  it('通り道は 画面の中を通る（窓の中だけのものは窓を通る）', () => {
    for (const id of SCENE_IDS) {
      for (const m of MOVERS[id]) {
        const mid = moverPos(m, m.sec / 2);
        expect(mid.x).toBeGreaterThan(0);
        expect(mid.x).toBeLessThan(1000);
        expect(mid.y).toBeGreaterThan(0);
        expect(mid.y).toBeLessThanOrEqual(1000);
        if (m.clip) {
          expect(mid.x).toBeGreaterThan(m.clip.x);
          expect(mid.x).toBeLessThan(m.clip.x + m.clip.w);
        }
      }
    }
  });
});
// うごくもの（コース）：コース1は なし、後半は前を横切る、保護者が切れる、タップは さえぎらない
import { expect, test } from '@playwright/test';
import { act, faceCenter, fresh, state, tapAt } from './helpers';

const KEY = 'moyou-kakurenbo-beta';

async function seed(page: import('@playwright/test').Page, cleared: number, movers = true) {
  await page.evaluate(
    ([k, cleared, movers]) => {
      localStorage.setItem(
        k as string,
        JSON.stringify({
          schema: 1,
          settings: { sound: false, difficulty: 'easy', tutorialSeen: true, movers },
          resume: null,
          playtest: { enabled: false, counters: {} },
          course: { cleared, current: Math.min(10, (cleared as number) + 1), finds: 0 },
          collection: { totalFinds: (cleared as number) * 10, sceneFinds: {} },
        }),
      );
    },
    [KEY, cleared, movers] as const,
  );
  await page.reload();
}

test('コース1は うごくもの なし、コース7は 3つ（前を通るものを含む）。上から押しても友だちが見つかる', async ({ page }) => {
  await fresh(page);
  await seed(page, 6);
  await act(page, 'toCourse');
  await act(page, 'pickCourse', '[data-course="1"]');
  await expect(page.locator('#stage .mv')).toHaveCount(0);
  await act(page, 'home');
  await act(page, 'toCourse');
  await act(page, 'pickCourse', '[data-course="7"]');
  await expect(page.locator('#stage .mv')).toHaveCount(3);
  await expect(page.locator('#stage .movers.front .mv')).not.toHaveCount(0);
  await page.waitForTimeout(1500);
  await page.screenshot({ path: 'test-results/movers/course7.png' });
  // 見つけても、うごくものは そのまま（数が変わらない）
  const s = await state(page);
  await tapAt(page, await faceCenter(page, 0));
  await expect(page.locator('#stage .mv')).toHaveCount(3);
  expect((await state(page)).session.found[0]).toBe(true);
  expect(s.session.placements.length).toBeGreaterThan(0);
});

test('保護者が「うごくものを出す」を切ると、出ない', async ({ page }) => {
  await fresh(page);
  await seed(page, 9, false);
  await act(page, 'toCourse');
  await act(page, 'pickCourse', '[data-course="10"]');
  await expect(page.locator('[data-screen="play"]')).toBeVisible();
  await expect(page.locator('#stage .mv')).toHaveCount(0);
});
// 遊べるかどうかを一か所で決める（Codex 総合レビュー指摘1〜4）。
// 進み具合（クリア数・見つけた回数）と、パックの利用権限（canPlay）の両方を満たすものだけを出す。
// 保存データの進み具合は購入の証明ではない。canPlay は本番では正規の購入確認だけを根拠にすること。
import { type CharacterId, unlockedCharacters } from './characters';
import type { Placement } from './placement';
import type { SceneId } from './scene';
import { STICKERS, type StickerDef } from './stickers';
import type { ContentId } from '../entitlements/entitlements';

export type CanPlay = (id: ContentId) => boolean;

/** 進み具合で仲間になっていて、しかもパックで遊べる友だち */
export function availableCharacters(cleared: number, sceneFinds: Partial<Record<SceneId, number>>, can: CanPlay): CharacterId[] {
  return unlockedCharacters(cleared, sceneFinds).filter((c) => can(`char:${c}`));
}

export function canPlayCourse(no: number, can: CanPlay): boolean {
  return can(`course:${no}`);
}

/** シールが属するパックの中身（それを遊べないなら、シールちょうに出さない） */
export function stickerRequires(s: StickerDef): ContentId[] {
  const need: ContentId[] = [`char:${s.char}`];
  if (s.kind === 'course') need.push(`course:${s.need}`);
  if (s.kind === 'scene' && s.scene) need.push(`scene:${s.scene}`);
  return need;
}

export function visibleStickers(can: CanPlay): StickerDef[] {
  return STICKERS.filter((s) => stickerRequires(s).every(can));
}

/** つづきから：背景と、置かれた全員がいま遊べるときだけ */
export function canResume(r: { sceneId: SceneId; placements: Placement[] }, can: CanPlay): boolean {
  return can(`scene:${r.sceneId}`) && r.placements.every((p) => can(`char:${p.char}`));
}
