  49.9% { transform: translate(var(--x1), var(--y1)) scaleX(var(--f0)); }
  50% { transform: translate(var(--x1), var(--y1)) scaleX(var(--f1)); }
  100% { transform: translate(var(--x0), var(--y0)) scaleX(var(--f1)); }
}
.mv-inner { transform-box: view-box; animation: mv-step 0.5s ease-in-out infinite alternate; }
.mv-inner.fly { animation: mv-fly 0.9s ease-in-out infinite alternate; }
.mv-inner.drift { animation: mv-drift 3s ease-in-out infinite alternate; }
@keyframes mv-step { from { transform: translateY(0); } to { transform: translateY(-5px); } }
@keyframes mv-fly { from { transform: translateY(0); } to { transform: translateY(-14px); } }
@keyframes mv-drift { from { transform: translateY(0); } to { transform: translateY(-6px); } }
@media (prefers-reduced-motion: reduce) {
