    { id: 'beach-cloud', kind: 'cloud', move: 'cross', from: { x: -150, y: 90 }, to: { x: 1150, y: 90 }, sec: 40, scale: 1.26, layer: 'back' },
    { id: 'beach-sailboat', kind: 'sailboat', move: 'patrol', from: { x: 380, y: 410 }, to: { x: 640, y: 410 }, sec: 24, scale: 0.84, layer: 'back' },
    { id: 'beach-seagull', kind: 'seagull', move: 'cross', from: { x: -100, y: 200 }, to: { x: 1100, y: 140 }, sec: 11, scale: 1.12, layer: 'back' },
    { id: 'beach-crab', kind: 'crab', move: 'patrol', from: { x: -90, y: 850 }, to: { x: 1090, y: 850 }, sec: 14, scale: 1.19, layer: 'front' },
    { id: 'beach-seagull2', kind: 'seagull', move: 'cross', from: { x: 1100, y: 600 }, to: { x: -100, y: 520 }, sec: 10, scale: 1.05, layer: 'front' },
  ],
};

/** コースごとの うごくものの数（コース1は なし） */
export const COURSE_MOVERS = [0, 1, 1, 2, 2, 3, 3, 4, 4, 5];
/** このコースから、友だちの前を通るもの も出る */
export const FRONT_FROM_COURSE = 6;

/** コース no の1回分に出す うごくもの（シードが同じなら同じ） */
export function pickMovers(scene: SceneId, courseNo: number, seed: number): MoverDef[] {
  const n = COURSE_MOVERS[Math.min(COURSE_MOVERS.length, Math.max(1, courseNo)) - 1];
  if (!n) return [];
  const rng: Rng = mulberry32(seed ^ 0x5eed);
  const list = MOVERS[scene];
  const back = shuffle(rng, list.filter((m) => m.layer === 'back'));
  const front = courseNo >= FRONT_FROM_COURSE ? shuffle(rng, list.filter((m) => m.layer === 'front')) : [];
  // 前半は うしろの物だけ。後半は 前を通る物を先に1つ以上
  const order = courseNo >= FRONT_FROM_COURSE ? [front[0], ...back, ...front.slice(1)] : back;
  return order.filter(Boolean).slice(0, n) as MoverDef[];
}

/** その時刻（秒）での位置。テストと、うしろの友だちを長く隠さないことの確認に使う */
export function moverPos(m: MoverDef, t: number): { x: number; y: number } {
  const period = m.move === 'patrol' ? m.sec * 2 : m.sec;
  let u = (((t % period) + period) % period) / m.sec;
  if (m.move === 'patrol' && u > 1) u = 2 - u;
  return { x: m.from.x + (m.to.x - m.from.x) * u, y: m.from.y + (m.to.y - m.from.y) * u };
}
// うごくもの の描画。動きは CSS（styles.css の mv-）でつける。
// 画面を描き直しても位置が飛ばないよう、出題の開始時刻からの経過で animation-delay を負にする。
import { moverArtFile } from '../art/registry';
import type { MoverDef, MoverKind } from '../core/movers';

const L = 'stroke="#4A3A40" stroke-width="5" stroke-linejoin="round" stroke-linecap="round"';

/** art/movers が無いときの、コードで描いた かんたんな絵（枠 -150 -300 300 300、足もと中央が 0,0） */
function fallback(kind: MoverKind): string {
  switch (kind) {
    case 'bird':
      return `<path d="M-34 -40 Q-16 -62 0 -42 Q16 -62 34 -40" fill="none" ${L}/><ellipse cx="0" cy="-36" rx="16" ry="10" fill="#F2B880" ${L}/><path d="M14 -38 L24 -34 L14 -32 Z" fill="#E9A23B"/>`;
    case 'seagull':
      return `<path d="M-46 -44 Q-22 -70 0 -44 Q22 -70 46 -44" fill="#FFFFFF" ${L}/><ellipse cx="0" cy="-40" rx="14" ry="8" fill="#FFFFFF" ${L}/>`;
    case 'butterfly':
      return `<ellipse cx="-14" cy="-46" rx="15" ry="20" fill="#F7C6CF" ${L}/><ellipse cx="14" cy="-46" rx="15" ry="20" fill="#F7C6CF" ${L}/><ellipse cx="-11" cy="-22" rx="10" ry="12" fill="#F6D7B8" ${L}/><ellipse cx="11" cy="-22" rx="10" ry="12" fill="#F6D7B8" ${L}/><path d="M0 -60 V-14" ${L}/>`;
    case 'cloud':
      return `<path d="M-110 -30 Q-120 -70 -78 -72 Q-66 -112 -18 -100 Q14 -130 52 -98 Q100 -104 104 -66 Q130 -50 110 -30 Z" fill="#FFFDF6" stroke="#E8DCCB" stroke-width="4"/>`;
    case 'cat':
    case 'puppy': {
      const c = kind === 'cat' ? '#F2C08A' : '#E8D2B4';
      const ears = kind === 'cat' ? `<path d="M30 -96 L36 -122 L50 -100 M54 -98 L66 -120 L70 -94" fill="${c}" ${L}/>` : `<path d="M28 -98 Q22 -76 34 -74 M68 -98 Q78 -78 66 -74" fill="${c}" ${L}/>`;
      return `<ellipse cx="0" cy="-2" rx="54" ry="6" fill="#4A3A40" opacity="0.1"/><path d="M-40 -6 V-36 M-20 -6 V-36 M14 -6 V-36 M32 -6 V-36" ${L}/><ellipse cx="-4" cy="-48" rx="50" ry="24" fill="${c}" ${L}/><path d="M-52 -54 Q-74 -80 -60 -96" fill="none" ${L}/>${ears}<circle cx="50" cy="-82" r="26" fill="${c}" ${L}/><circle cx="44" cy="-84" r="3.5" fill="#4A3A40"/><circle cx="60" cy="-84" r="3.5" fill="#4A3A40"/>`;
    }
    case 'balloon':
      return `<path d="M0 0 Q-8 -30 0 -60" fill="none" stroke="#4A3A40" stroke-width="3"/><ellipse cx="0" cy="-96" rx="30" ry="36" fill="#F4A6A6" ${L}/><path d="M-4 -60 L4 -60 L0 -66 Z" fill="#F4A6A6" ${L}/>`;
    case 'sailboat':
      return `<path d="M-50 -20 H50 L36 0 H-36 Z" fill="#E9967A" ${L}/><path d="M0 -22 V-120 L44 -30 Z" fill="#FFFFFF" ${L}/><path d="M-4 -110 L-40 -30 H-4 Z" fill="#A9D3E8" ${L}/>`;
    case 'crab':
      return `<ellipse cx="0" cy="-4" rx="40" ry="5" fill="#4A3A40" opacity="0.1"/><path d="M-26 -14 L-40 -2 M-14 -12 L-24 0 M26 -14 L40 -2 M14 -12 L24 0" ${L}/><ellipse cx="0" cy="-26" rx="32" ry="20" fill="#F08C78" ${L}/><path d="M-30 -36 Q-50 -60 -36 -66 Q-28 -56 -40 -50 M30 -36 Q50 -60 36 -66 Q28 -56 40 -50" fill="#F08C78" ${L}/><circle cx="-10" cy="-30" r="3.5" fill="#4A3A40"/><circle cx="10" cy="-30" r="3.5" fill="#4A3A40"/>`;
    case 'ball':
      return `<ellipse cx="0" cy="-2" rx="26" ry="5" fill="#4A3A40" opacity="0.1"/><circle cx="0" cy="-32" r="30" fill="#FFF6E8" ${L}/><path d="M-10 -60 Q-22 -32 -10 -4 M10 -60 Q22 -32 10 -4" fill="none" stroke="#E07B7B" stroke-width="7"/>`;
  }
}

function art(kind: MoverKind): string {
  const f = moverArtFile(kind);
  return f ? `<image href="${f}" x="-150" y="-300" width="300" height="300"/>` : fallback(kind);
}

const FLY: MoverKind[] = ['bird', 'seagull', 'butterfly', 'balloon'];

/** うごくもの1つ。elapsed：出題が始まってからの秒数 */
function one(P: string, m: MoverDef, elapsed: number): string {
  const period = m.move === 'patrol' ? m.sec * 2 : m.sec;
  const right = m.to.x >= m.from.x;
  const vars = [
    `--x0:${m.from.x}px`,
    `--y0:${m.from.y}px`,
    `--x1:${m.to.x}px`,
    `--y1:${m.to.y}px`,
    `--f0:${right ? 1 : -1}`,
    `--f1:${right ? -1 : 1}`,
    `--period:${period}s`,
    `--delay:${-(elapsed % period).toFixed(2)}s`,
  ].join(';');
  const inner = `<g class="mv-inner${FLY.includes(m.kind) ? ' fly' : m.kind === 'cloud' || m.kind === 'sailboat' ? ' drift' : ' step'}"><g transform="scale(${m.scale})">${art(m.kind)}</g></g>`;
  const g = `<g class="mv mv-${m.move}" data-mover="${m.id}" style="${vars}" aria-hidden="true">${inner}</g>`;
  if (!m.clip) return g;
  const id = `${P}mvclip-${m.id}`;
  return `<clipPath id="${id}"><rect x="${m.clip.x}" y="${m.clip.y}" width="${m.clip.w}" height="${m.clip.h}"/></clipPath><g clip-path="url(#${id})">${g}</g>`;
}

export function moversMarkup(P: string, movers: MoverDef[], elapsed: number): { back: string; front: string } {
  return {
    back: movers.filter((m) => m.layer === 'back').map((m) => one(P, m, elapsed)).join(''),
    front: movers.filter((m) => m.layer === 'front').map((m) => one(P, m, elapsed)).join(''),
  };
}
// つぎの ごほうび：「あと なんコースで だれが なかまに／どのシール」を、前もって見せるための計算。
// 突然「なかまに なったよ」と出るのではなく、目標が見えて、近づいていくのが分かるようにする（ご本人の要望 2026-10-15）。
import { FRIEND_UNLOCKS, type CharacterId } from './characters';
import { type CanPlay, canPlayCourse, visibleStickers } from './access';
import type { SceneId } from './scene';
import { type StickerDef, hasSticker } from './stickers';
import { ROOMS, type RoomDef } from './myroom';

export type UpcomingReward =
  /** コース at をクリアすると、なかまが ふえる。remaining：あと何コース */
  | { kind: 'friend'; char: CharacterId; at: number; remaining: number }
  /** コース at をクリアすると、シール */
  | { kind: 'courseSticker'; sticker: StickerDef; at: number; remaining: number }
  /** 見つけた合計が at 回になると、シール。done：いまの回数 */
  | { kind: 'findsSticker'; sticker: StickerDef; at: number; remaining: number; done: number }
  /** コース at をクリアすると、じぶんの へや に部屋が ふえる */
  | { kind: 'room'; room: RoomDef; at: number; remaining: number };

export interface RewardProgress {
  cleared: number;
  totalFinds: number;
  sceneFinds?: Partial<Record<SceneId, number>>;
}

/** つぎに もらえる ごほうび（なかま・コースのシール・回数のシール の順に、それぞれいちばん近いもの） */
export function upcomingRewards(p: RewardProgress, can: CanPlay): UpcomingReward[] {
  const out: UpcomingReward[] = [];
  const friend = FRIEND_UNLOCKS.filter((f) => f.course > p.cleared && can(`char:${f.char}`) && canPlayCourse(f.course, can)).sort((a, b) => a.course - b.course)[0];
  if (friend) out.push({ kind: 'friend', char: friend.char, at: friend.course, remaining: friend.course - p.cleared });
  const stickers = visibleStickers(can).filter((s) => !hasSticker(s, p.cleared, p.totalFinds, p.sceneFinds));
  const cs = stickers.filter((s) => s.kind === 'course' && canPlayCourse(s.need, can)).sort((a, b) => a.need - b.need)[0];
  if (cs) out.push({ kind: 'courseSticker', sticker: cs, at: cs.need, remaining: cs.need - p.cleared });
  const fs = stickers.filter((s) => s.kind === 'finds').sort((a, b) => a.need - b.need)[0];
  if (fs) out.push({ kind: 'findsSticker', sticker: fs, at: fs.need, remaining: fs.need - p.totalFinds, done: p.totalFinds });
  const room = ROOMS.filter((r) => r.needCleared > p.cleared && can(r.content) && canPlayCourse(r.needCleared, can)).sort((a, b) => a.needCleared - b.needCleared)[0];
  if (room) out.push({ kind: 'room', room, at: room.needCleared, remaining: room.needCleared - p.cleared });
  return out;
}

/** コース no をクリアすると なかまに なる友だち（コースのタイルに顔を出す） */
export function friendAtCourse(no: number, can: CanPlay): CharacterId | null {
  const f = FRIEND_UNLOCKS.find((x) => x.course === no && can(`char:${x.char}`));
  return f ? f.char : null;
}
// 将来の「追加パック（買い切り）」との境界。方針：strategy/MONETIZATION.md
// このベータでは課金を実装しない。ここにある値は購入の証明ではない。
// 本番で購入を扱う場合は、StoreKit / Google Play Billing など正規の決済経路の
// 検証結果だけを根拠にし、端末内のフラグ（localStorage等）を購入証明にしてはいけない。
import type { CharacterId } from '../core/characters';
import type { SceneId } from '../core/scene';

export type ContentId = `scene:${SceneId}` | `course:${number}` | `char:${CharacterId}` | 'trial:hardest' | `costume-pack:${string}` | `room:${string}`;

export type PackId = 'base' | 'more-courses' | 'beach';

export interface PackDef {
  id: PackId;
  /** 保護者の画面などで使う名前 */
  name: string;
  /** 無料（最初から遊べる） */
  free: boolean;
  contents: ContentId[];
}

const courses = (from: number, to: number): ContentId[] => Array.from({ length: to - from + 1 }, (_, i) => `course:${from + i}` as ContentId);

/**
 * パックの一覧。どの中身も、ちょうど1つのパックに入る。
 * 基本（無料）には「最初のごほうび（コース1で仲間になる にゃこ）」まで必ず入れる。
 * 追加パックは、新しい背景＋新しい友だち＋シール、の形で足していく。
 */
export const PACKS: PackDef[] = [
  {
    id: 'base',
    name: 'きほん',
    free: true,
    // コース1・5で仲間になる にゃこ・ぽぽ は、無料の範囲のごほうび
    contents: ['scene:room', 'scene:garden', 'scene:shop', ...courses(1, 5), 'char:koro', 'char:mimi', 'char:moko', 'char:nyako', 'char:popo', 'room:living', 'room:bedroom'],
  },
  {
    id: 'more-courses',
    name: 'つづきの コース',
    free: false,
    contents: [...courses(6, 10), 'trial:hardest', 'room:yard'],
  },
  {
    id: 'beach',
    name: 'うみべ パック',
    free: false,
    contents: ['scene:beach', 'char:choki'],
  },
];

export function packOf(id: ContentId): PackDef | undefined {
  return PACKS.find((p) => p.contents.includes(id));
}

export interface EntitlementSource {
  /** 'beta-all-unlocked' はベータの全開放であり、購入状態ではない */
  readonly kind: 'beta-all-unlocked';
  canPlay(id: ContentId): boolean;
}

export const betaEntitlements: EntitlementSource = {
  kind: 'beta-all-unlocked',
  canPlay: () => true,
};
// 端末内保存のスキーマ。子どもの氏名・誕生日・写真・音声・端末IDは持たない。
import { CHARACTER_IDS, type CharacterId } from '../core/characters';
import type { Difficulty, Placement } from '../core/placement';
import type { SceneId } from '../core/scene';
import { SCENES, SCENE_IDS } from '../core/scenes';
import { ROOMS, type RoomId, type RoomLayouts, validLayouts } from '../core/myroom';

export const STORAGE_KEY = 'moyou-kakurenbo-beta';
export const SCHEMA_VERSION = 1;

export interface Settings {
  sound: boolean;
  difficulty: Difficulty;
  tutorialSeen: boolean;
  /** コースの うごくもの（保護者が切れる。初期値 ON） */
  movers: boolean;
}

export interface ResumeState {
  sceneId: SceneId;
  difficulty: Difficulty;
  placements: Placement[];
  found: boolean[];
  origin: 'search' | 'hide';
}

export interface PlaytestCounters {
  searchStarted: number;
  searchCompleted: number;
  hintsUsed: number;
  hideRounds: number;
  /** 1回のプレイ時間のおおまかな区分（秒は残さない） */
  durationUnder1m: number;
  duration1to3m: number;
  durationOver3m: number;
}

export interface SaveData {
  schema: typeof SCHEMA_VERSION;
  settings: Settings;
  resume: ResumeState | null;
  playtest: { enabled: boolean; counters: PlaytestCounters };
  course: CourseProgress;
  /** シールちょう用：見つけた合計回数（コース・さがす・かくして わたす。おためしは数えない） */
  collection: { totalFinds: number; sceneFinds: Partial<Record<SceneId, number>> };
  /** じぶんの へや：部屋ごとの置き方と、いま開いている部屋 */
  myroom: { layouts: RoomLayouts; current: RoomId };
}

/** コースの進み具合。cleared：クリアした最後のコース（0〜10）。current の finds：そのコースで見つけた回数 */
export interface CourseProgress {
  cleared: number;
  current: number;
  finds: number;
}

export const COURSE_COUNT = 10;
export const COURSE_FINDS = 10;

export function emptyCourse(): CourseProgress {
  return { cleared: 0, current: 1, finds: 0 };
}

const isInt = (v: unknown, lo: number, hi: number): v is number => typeof v === 'number' && Number.isInteger(v) && v >= lo && v <= hi;

/** 壊れた値は使える範囲に直す。遊べるのは「クリアした次」まで */
export function validateCourse(v: unknown): { course: CourseProgress; repaired: boolean } {
  if (v === undefined) return { course: emptyCourse(), repaired: false }; // 以前の保存データ（コース追加前）
  if (typeof v !== 'object' || v === null) return { course: emptyCourse(), repaired: true };
  const o = v as Record<string, unknown>;
  if (!isInt(o.cleared, 0, COURSE_COUNT) || !isInt(o.current, 1, COURSE_COUNT) || !isInt(o.finds, 0, COURSE_FINDS - 1)) {
    return { course: emptyCourse(), repaired: true };
  }
  if (o.current > Math.min(COURSE_COUNT, o.cleared + 1)) return { course: { cleared: o.cleared, current: Math.min(COURSE_COUNT, o.cleared + 1), finds: 0 }, repaired: true };
  return { course: { cleared: o.cleared, current: o.current, finds: o.finds }, repaired: false };
}

export const COUNTER_MAX = 9999;

export function emptyCounters(): PlaytestCounters {
  return { searchStarted: 0, searchCompleted: 0, hintsUsed: 0, hideRounds: 0, durationUnder1m: 0, duration1to3m: 0, durationOver3m: 0 };
}

export function defaults(): SaveData {
  return {
    schema: SCHEMA_VERSION,
    settings: { sound: true, difficulty: 'easy', tutorialSeen: false, movers: true },
    resume: null,
    playtest: { enabled: false, counters: emptyCounters() },
    course: emptyCourse(),
    collection: { totalFinds: 0, sceneFinds: {} },
    myroom: { layouts: {}, current: 'living' },
  };
}

const isObj = (v: unknown): v is Record<string, unknown> => typeof v === 'object' && v !== null && !Array.isArray(v);
const isBool = (v: unknown): v is boolean => typeof v === 'boolean';
const isDiff = (v: unknown): v is Difficulty => v === 'easy' || v === 'normal';

function validPlacement(sceneId: SceneId, v: unknown): v is Placement {
  if (!isObj(v)) return false;
  const scene = SCENES[sceneId];
  return (
    CHARACTER_IDS.includes(v.char as CharacterId) &&
    typeof v.spot === 'string' &&
    scene.spots.some((s) => s.id === v.spot) &&
    typeof v.costume === 'string' &&
    scene.costumes.some((c) => c.id === v.costume) &&
    (v.variant === 'exact' || v.variant === 'soft')
  );
}

export function validateResume(v: unknown): ResumeState | null {
  if (!isObj(v)) return null;
  if (!SCENE_IDS.includes(v.sceneId as SceneId)) return null;
  const sceneId = v.sceneId as SceneId;
  if (!isDiff(v.difficulty)) return null;
  if (v.origin !== 'search' && v.origin !== 'hide') return null;
  if (!Array.isArray(v.placements) || v.placements.length < 1 || v.placements.length > 3) return null;
  if (!v.placements.every((p) => validPlacement(sceneId, p))) return null;
  if (!Array.isArray(v.found) || v.found.length !== v.placements.length || !v.found.every(isBool)) return null;
  const chars = new Set((v.placements as Placement[]).map((p) => p.char));
  const spots = new Set((v.placements as Placement[]).map((p) => p.spot));
  if (chars.size !== v.placements.length || spots.size !== v.placements.length) return null;
  return {
    sceneId,
    difficulty: v.difficulty,
    origin: v.origin,
    placements: (v.placements as Placement[]).map((p) => ({ char: p.char, spot: p.spot, costume: p.costume, variant: p.variant })),
    found: (v.found as boolean[]).slice(),
  };
}

function validCount(v: unknown): number {
  return typeof v === 'number' && Number.isInteger(v) && v >= 0 ? Math.min(v, COUNTER_MAX) : 0;
}

/**
 * 読み込んだ値を検証する。部分的に壊れていても、使える部分だけ残して既定値で補う。
 * 返り値の repaired が true なら何かを直した。
 */
export function validate(raw: unknown): { data: SaveData; repaired: boolean } {
  const d = defaults();
  if (!isObj(raw) || raw.schema !== SCHEMA_VERSION) return { data: d, repaired: true };
  let repaired = false;
  const s = raw.settings;
  if (isObj(s)) {
    if (isBool(s.sound)) d.settings.sound = s.sound;
    else repaired = true;
    if (isDiff(s.difficulty)) d.settings.difficulty = s.difficulty;
    else repaired = true;
    if (isBool(s.tutorialSeen)) d.settings.tutorialSeen = s.tutorialSeen;
    else repaired = true;
    // 以前の保存データには無い（そのときは ON のまま）
    if (isBool(s.movers)) d.settings.movers = s.movers;
    else if (s.movers !== undefined) repaired = true;
  } else repaired = true;
  if (raw.resume !== null && raw.resume !== undefined) {
    const r = validateResume(raw.resume);
    if (r) d.resume = r;
    else repaired = true;
  }
  const p = raw.playtest;
  if (isObj(p) && isBool(p.enabled) && isObj(p.counters)) {
    d.playtest.enabled = p.enabled;
    const c = p.counters;
    for (const k of Object.keys(d.playtest.counters) as (keyof PlaytestCounters)[]) {
      const v = validCount(c[k]);
      if (v !== c[k]) repaired = true;
      d.playtest.counters[k] = v;
    }
    // OFF のときは集計を持たない
    if (!d.playtest.enabled) d.playtest.counters = emptyCounters();
  } else if (p !== undefined) repaired = true;
  const col = raw.collection;
  if (col !== undefined) {
    const tf = typeof col === 'object' && col !== null ? (col as Record<string, unknown>).totalFinds : undefined;
    const v = validCount(tf);
    if (v !== tf) repaired = true;
    d.collection.totalFinds = v;
    const sf = typeof col === 'object' && col !== null ? (col as Record<string, unknown>).sceneFinds : undefined;
    if (sf !== undefined) {
      if (typeof sf !== 'object' || sf === null) repaired = true;
      else
        for (const [k, n] of Object.entries(sf as Record<string, unknown>)) {
          if (!SCENE_IDS.includes(k as SceneId)) {
            repaired = true;
            continue;
          }
          const c = validCount(n);
          if (c !== n) repaired = true;
          d.collection.sceneFinds[k as SceneId] = c;
        }
    }
  }
  const course = validateCourse(raw.course);
  d.course = course.course;
  if (course.repaired) repaired = true;
  // じぶんの へや：壊れた部屋だけ消す（ほかの部屋と進み具合は残す）
  if (raw.myroom !== undefined) {
    const m = raw.myroom;
    if (isObj(m)) {
      d.myroom.layouts = validLayouts(m.layouts, CHARACTER_IDS);
      if (isObj(m.layouts) && Object.keys(m.layouts).length !== Object.keys(d.myroom.layouts).length) repaired = true;
      if (ROOMS.some((r) => r.id === m.current)) d.myroom.current = m.current as RoomId;
    } else repaired = true;
  }
  return { data: d, repaired };
}
// じぶんの へや：開く・棚から置く・動かす・座らせる・しまう・保存・部屋の数（無料は2部屋まで）
import { expect, test } from '@playwright/test';
import { act, fresh } from './helpers';

const KEY = 'moyou-kakurenbo-beta';
const SHOTS = 'test-results/myroom';

async function seed(page: import('@playwright/test').Page, cleared: number, myroom?: unknown) {
  await page.evaluate(
    ([k, cleared, myroom]) => {
      localStorage.setItem(
        k as string,
        JSON.stringify({
          schema: 1,
          settings: { sound: false, difficulty: 'easy', tutorialSeen: true, movers: true },
          resume: null,
          playtest: { enabled: false, counters: {} },
          course: { cleared, current: Math.min(10, (cleared as number) + 1), finds: 0 },
          collection: { totalFinds: (cleared as number) * 10, sceneFinds: {} },
          ...(myroom ? { myroom } : {}),
        }),
      );
    },
    [KEY, cleared, myroom ?? null] as const,
  );
  await page.reload();
}

const saved = (page: import('@playwright/test').Page) => page.evaluate((k) => JSON.parse(localStorage.getItem(k)!).myroom, KEY);

test('はじめて開くと リビングに ソファ・テーブル・ラグ と ころ。コース0なら部屋は1つ', async ({ page }) => {
  await fresh(page);
  await seed(page, 0);
  await act(page, 'toMyRoom');
  await expect(page.locator('[data-screen="myroom"]')).toBeVisible();
  await expect(page.locator('#stage.loading')).toHaveCount(0);
  await expect(page.locator('.mr-obj')).toHaveCount(4);
  await expect(page.locator('.mr-room-tab')).toHaveCount(0);
  const m = await saved(page);
  expect(m.layouts.living.map((p: { ref: string }) => p.ref).sort()).toEqual(['char:koro', 'item:rug', 'item:sofa', 'item:table']);
  await page.screenshot({ path: `${SHOTS}/start.png` });
});

test('棚の友だちをタップすると置け、もう一度タップで しまえる。もの は シールの分だけ', async ({ page }) => {
  await fresh(page);
  await seed(page, 4);
  await act(page, 'toMyRoom');
