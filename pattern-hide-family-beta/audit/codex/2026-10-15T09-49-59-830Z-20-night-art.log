const head=['"'back','clothes-mask','clothes-shade','clothes-line','front'].map(n=>"'`<img style="position:absolute;width:180px;height:240px" src="${data('"'characters/hika/'+n+'.svg')}\">"'`).join('"'');
await page.setContent("'`<body style="margin:16px;background:#f4eee2"><div style="display:flex"><div style="position:relative;width:500px;height:500px">${['"'back','over','minor','fore'].map(n=>"'`<img style="position:absolute;width:500px;height:500px" src="${data('"'scenes/night/'+n+'.svg')}\">"'`).join('"'')}</div><img style=\"width:500px;height:500px\" src=\""'${data('"'myroom/rooms/veranda.svg')}\"><div style=\"position:relative;width:180px;height:240px\">"'${head}</div></div>${['"'myroom/items/engawa-bench.svg','myroom/items/paper-lantern.svg','myroom/items/bamboo-chair.svg','myroom/items/frog-plush.svg',...['1','5','15','30','50'].map(n=>'stickers/n-s'+n+'.svg')].map(thumb).join('')}</body>"'`);
await page.evaluate(()=>Promise.all([...document.images].map(i=>i.decode())));await page.screenshot({path:'"'art/.night-preview.png',fullPage:true});await b.close();
