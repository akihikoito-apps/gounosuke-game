1: // 端末内保存のスキーマ。子どもの氏名・誕生日・写真・音声・端末IDは持たない。
2: import { CHARACTER_IDS, type CharacterId } from '../core/characters';
3: import type { Difficulty, Placement } from '../core/placement';
4: import type { SceneId } from '../core/scene';
5: import { SCENES, SCENE_IDS } from '../core/scenes';
6: 
7: export const STORAGE_KEY = 'moyou-kakurenbo-beta';
8: export const SCHEMA_VERSION = 1;
9: 
10: export interface Settings {
11:   sound: boolean;
12:   difficulty: Difficulty;
13:   tutorialSeen: boolean;
14: }
15: 
16: export interface ResumeState {
17:   sceneId: SceneId;
18:   difficulty: Difficulty;
19:   placements: Placement[];
20:   found: boolean[];
21:   origin: 'search' | 'hide';
22: }
23: 
24: export interface PlaytestCounters {
25:   searchStarted: number;
26:   searchCompleted: number;
27:   hintsUsed: number;
28:   hideRounds: number;
29:   /** 1回のプレイ時間のおおまかな区分（秒は残さない） */
30:   durationUnder1m: number;
31:   duration1to3m: number;
32:   durationOver3m: number;
33: }
34: 
35: export interface SaveData {
36:   schema: typeof SCHEMA_VERSION;
37:   settings: Settings;
38:   resume: ResumeState | null;
39:   playtest: { enabled: boolean; counters: PlaytestCounters };
40:   course: CourseProgress;
41:   /** シールちょう用：見つけた合計回数（コース・さがす・かくして わたす。おためしは数えない） */
42:   collection: { totalFinds: number; sceneFinds: Partial<Record<SceneId, number>> };
43: }
44: 
45: /** コースの進み具合。cleared：クリアした最後のコース（0〜10）。current の finds：そのコースで見つけた回数 */
46: export interface CourseProgress {
47:   cleared: number;
48:   current: number;
49:   finds: number;
50: }
51: 
52: export const COURSE_COUNT = 10;
53: export const COURSE_FINDS = 10;
54: 
55: export function emptyCourse(): CourseProgress {
56:   return { cleared: 0, current: 1, finds: 0 };
57: }
58: 
59: const isInt = (v: unknown, lo: number, hi: number): v is number => typeof v === 'number' && Number.isInteger(v) && v >= lo && v <= hi;
60: 
61: /** 壊れた値は使える範囲に直す。遊べるのは「クリアした次」まで */
62: export function validateCourse(v: unknown): { course: CourseProgress; repaired: boolean } {
63:   if (v === undefined) return { course: emptyCourse(), repaired: false }; // 以前の保存データ（コース追加前）
64:   if (typeof v !== 'object' || v === null) return { course: emptyCourse(), repaired: true };
65:   const o = v as Record<string, unknown>;
66:   if (!isInt(o.cleared, 0, COURSE_COUNT) || !isInt(o.current, 1, COURSE_COUNT) || !isInt(o.finds, 0, COURSE_FINDS - 1)) {
67:     return { course: emptyCourse(), repaired: true };
68:   }
69:   if (o.current > Math.min(COURSE_COUNT, o.cleared + 1)) return { course: { cleared: o.cleared, current: Math.min(COURSE_COUNT, o.cleared + 1), finds: 0 }, repaired: true };
70:   return { course: { cleared: o.cleared, current: o.current, finds: o.finds }, repaired: false };
71: }
72: 
73: export const COUNTER_MAX = 9999;
74: 
75: export function emptyCounters(): PlaytestCounters {
76:   return { searchStarted: 0, searchCompleted: 0, hintsUsed: 0, hideRounds: 0, durationUnder1m: 0, duration1to3m: 0, durationOver3m: 0 };
77: }
78: 
79: export function defaults(): SaveData {
80:   return {
81:     schema: SCHEMA_VERSION,
82:     settings: { sound: true, difficulty: 'easy', tutorialSeen: false },
83:     resume: null,
84:     playtest: { enabled: false, counters: emptyCounters() },
85:     course: emptyCourse(),
86:     collection: { totalFinds: 0, sceneFinds: {} },
87:   };
88: }
89: 
90: const isObj = (v: unknown): v is Record<string, unknown> => typeof v === 'object' && v !== null && !Array.isArray(v);
91: const isBool = (v: unknown): v is boolean => typeof v === 'boolean';
92: const isDiff = (v: unknown): v is Difficulty => v === 'easy' || v === 'normal';
93: 
94: function validPlacement(sceneId: SceneId, v: unknown): v is Placement {
95:   if (!isObj(v)) return false;
96:   const scene = SCENES[sceneId];
97:   return (
98:     CHARACTER_IDS.includes(v.char as CharacterId) &&
99:     typeof v.spot === 'string' &&
100:     scene.spots.some((s) => s.id === v.spot) &&
101:     typeof v.costume === 'string' &&
102:     scene.costumes.some((c) => c.id === v.costume) &&
103:     (v.variant === 'exact' || v.variant === 'soft')
104:   );
105: }
106: 
107: export function validateResume(v: unknown): ResumeState | null {
108:   if (!isObj(v)) return null;
109:   if (!SCENE_IDS.includes(v.sceneId as SceneId)) return null;
110:   const sceneId = v.sceneId as SceneId;
111:   if (!isDiff(v.difficulty)) return null;
112:   if (v.origin !== 'search' && v.origin !== 'hide') return null;
113:   if (!Array.isArray(v.placements) || v.placements.length < 1 || v.placements.length > 3) return null;
114:   if (!v.placements.every((p) => validPlacement(sceneId, p))) return null;
115:   if (!Array.isArray(v.found) || v.found.length !== v.placements.length || !v.found.every(isBool)) return null;
116:   const chars = new Set((v.placements as Placement[]).map((p) => p.char));
117:   const spots = new Set((v.placements as Placement[]).map((p) => p.spot));
118:   if (chars.size !== v.placements.length || spots.size !== v.placements.length) return null;
119:   return {
120:     sceneId,
121:     difficulty: v.difficulty,
122:     origin: v.origin,
123:     placements: (v.placements as Placement[]).map((p) => ({ char: p.char, spot: p.spot, costume: p.costume, variant: p.variant })),
124:     found: (v.found as boolean[]).slice(),
125:   };
126: }
127: 
128: function validCount(v: unknown): number {
129:   return typeof v === 'number' && Number.isInteger(v) && v >= 0 ? Math.min(v, COUNTER_MAX) : 0;
130: }
131: 
132: /**
133:  * 読み込んだ値を検証する。部分的に壊れていても、使える部分だけ残して既定値で補う。
134:  * 返り値の repaired が true なら何かを直した。
135:  */
136: export function validate(raw: unknown): { data: SaveData; repaired: boolean } {
137:   const d = defaults();
138:   if (!isObj(raw) || raw.schema !== SCHEMA_VERSION) return { data: d, repaired: true };
139:   let repaired = false;
140:   const s = raw.settings;
141:   if (isObj(s)) {
142:     if (isBool(s.sound)) d.settings.sound = s.sound;
143:     else repaired = true;
144:     if (isDiff(s.difficulty)) d.settings.difficulty = s.difficulty;
145:     else repaired = true;
146:     if (isBool(s.tutorialSeen)) d.settings.tutorialSeen = s.tutorialSeen;
147:     else repaired = true;
148:   } else repaired = true;
149:   if (raw.resume !== null && raw.resume !== undefined) {
150:     const r = validateResume(raw.resume);
151:     if (r) d.resume = r;
152:     else repaired = true;
153:   }
154:   const p = raw.playtest;
155:   if (isObj(p) && isBool(p.enabled) && isObj(p.counters)) {
156:     d.playtest.enabled = p.enabled;
157:     const c = p.counters;
158:     for (const k of Object.keys(d.playtest.counters) as (keyof PlaytestCounters)[]) {
159:       const v = validCount(c[k]);
160:       if (v !== c[k]) repaired = true;
161:       d.playtest.counters[k] = v;
162:     }
163:     // OFF のときは集計を持たない
164:     if (!d.playtest.enabled) d.playtest.counters = emptyCounters();
165:   } else if (p !== undefined) repaired = true;
166:   const col = raw.collection;
167:   if (col !== undefined) {
168:     const tf = typeof col === 'object' && col !== null ? (col as Record<string, unknown>).totalFinds : undefined;
169:     const v = validCount(tf);
170:     if (v !== tf) repaired = true;
171:     d.collection.totalFinds = v;
172:     const sf = typeof col === 'object' && col !== null ? (col as Record<string, unknown>).sceneFinds : undefined;
173:     if (sf !== undefined) {
174:       if (typeof sf !== 'object' || sf === null) repaired = true;
175:       else
176:         for (const [k, n] of Object.entries(sf as Record<string, unknown>)) {
177:           if (!SCENE_IDS.includes(k as SceneId)) {
178:             repaired = true;
179:             continue;
180:           }
181:           const c = validCount(n);
182:           if (c !== n) repaired = true;
183:           d.collection.sceneFinds[k as SceneId] = c;
184:         }
185:     }
186:   }
187:   const course = validateCourse(raw.course);
188:   d.course = course.course;
189:   if (course.repaired) repaired = true;
190:   return { data: d, repaired };
191: }

