FILE native/store-shots.mjs
1: // App Store に出す画面写真を作る（iPhone 6.9インチ 1320×2868・iPad 13インチ 2064×2752）。
2: // アプリ版の www をそのまま表示し、「少し遊んだあと」の保存データを入れてから撮る。
3: // 使い方（native フォルダで）: node build-www.mjs && node store-shots.mjs  → store-shots/ に PNG
4: import { chromium } from '@playwright/test';
5: import http from 'node:http';
6: import { readFileSync, existsSync, mkdirSync } from 'node:fs';
7: import { join, extname } from 'node:path';
8: import { fileURLToPath } from 'node:url';
9: 
10: const here = fileURLToPath(new URL('.', import.meta.url));
11: const root = join(here, 'www');
12: const out = join(here, 'store-shots');
13: mkdirSync(out, { recursive: true });
14: const types = { '.html': 'text/html', '.js': 'text/javascript', '.css': 'text/css', '.svg': 'image/svg+xml', '.png': 'image/png', '.webmanifest': 'application/json' };
15: const srv = http
16:   .createServer((q, r) => {
17:     let p = decodeURIComponent(q.url.split('?')[0]);
18:     if (p === '/') p = '/index.html';
19:     const f = join(root, p);
20:     if (!existsSync(f)) return r.writeHead(404).end();
21:     r.writeHead(200, { 'content-type': types[extname(f)] || 'application/octet-stream' }).end(readFileSync(f));
22:   })
23:   .listen(4198);
24: const URL0 = 'http://localhost:4198/';
25: 
26: // 4コースまでクリア・5コース目の途中・うみべで少し遊んだ状態
27: const save = {
28:   schema: 1,
29:   settings: { sound: true, difficulty: 'easy', tutorialSeen: true },
30:   resume: null,
31:   playtest: { enabled: false, counters: { searchStarted: 0, searchCompleted: 0, hintsUsed: 0, hideRounds: 0, durationUnder1m: 0, duration1to3m: 0, durationOver3m: 0 } },
32:   course: { cleared: 4, current: 5, finds: 3 },
33:   collection: { totalFinds: 46, sceneFinds: { room: 14, garden: 12, shop: 9, beach: 11 } },
34: };
35: 
36: const devices = [
37:   { name: 'iphone69', viewport: { width: 440, height: 956 }, scale: 3, mobile: true },
38:   { name: 'ipad13', viewport: { width: 1032, height: 1376 }, scale: 2, mobile: false },
39: ];
40: const b = await chromium.launch();
41: const errs = [];
42: for (const d of devices) {
43:   const ctx = await b.newContext({ viewport: d.viewport, deviceScaleFactor: d.scale, hasTouch: true, isMobile: d.mobile });
44:   await ctx.addInitScript(([k, v]) => { if (!localStorage.getItem(k)) localStorage.setItem(k, v); }, ['moyou-kakurenbo-beta', JSON.stringify(save)]);
45:   const p = await ctx.newPage();
46:   p.on('pageerror', (e) => errs.push(`${d.name}: ${e.message}`));
47:   let n = 0;
48:   const shot = async (k) => {
49:     await p.waitForTimeout(1200);
50:     await p.screenshot({ path: join(out, `${d.name}-${++n}-${k}.png`) });
51:   };
52:   await p.goto(URL0);
53:   await shot('title');
54:   await p.click('[data-action=toCourse]');
55:   await shot('courses');
56:   await p.click('[data-course="5"]');
57:   await shot('course5');
58:   await p.goto(URL0);
59:   await p.click('[data-action=toSearch]');
60:   await p.waitForTimeout(500);
61:   await p.click('[data-diff=normal]');
62:   await p.click('[data-action=startSearch][data-scene=beach]');
63:   await shot('beach');
64:   await p.goto(URL0);
65:   await p.click('[data-action=toStickers]');
66:   await shot('stickers');
67:   await ctx.close();
68: }
69: await b.close();
70: srv.close();
71: if (errs.length) { console.error(errs.join('\n')); process.exit(1); }
72: console.log(`画面写真を ${out} に書き出しました`);
FILE native/store-frame.mjs
1: // store-shots.mjs で撮った画面写真に、上に短い見出しを付けて App Store 用に仕上げる。
2: // 大きさは元と同じ（iPhone 1320×2868・iPad 2064×2752）。出力は store-shots/framed/
3: // 使い方（native フォルダで）: node store-shots.mjs && node store-frame.mjs
4: import { chromium } from '@playwright/test';
5: import { readFileSync, readdirSync, mkdirSync } from 'node:fs';
6: import { join } from 'node:path';
7: import { fileURLToPath } from 'node:url';
8: 
9: const here = fileURLToPath(new URL('.', import.meta.url));
10: const src = join(here, 'store-shots');
11: const out = join(src, 'framed');
12: mkdirSync(out, { recursive: true });
13: 
14: // 画面写真の名前（末尾）→ 見出し。子どもと親の両方が読めるよう、ひらがな中心で短く
15: const CAPTIONS = {
16:   title: ['もように まぎれて', 'かくれんぼ'],
17:   courses: ['10の コースを', 'じゅんばんに'],
18:   course5: ['ぼうしや かさで', 'だんだん むずかしく'],
19:   beach: ['うみべで', 'あたらしい ともだち'],
20:   stickers: ['みつけるたびに', 'シールが ふえる'],
21: };
22: const SIZES = { iphone69: [1320, 2868], ipad13: [2064, 2752] };
23: 
24: const b = await chromium.launch();
25: const files = readdirSync(src).filter((f) => f.endsWith('.png'));
26: for (const f of files) {
27:   const [dev, , key] = f.replace('.png', '').split('-');
28:   const [W, H] = SIZES[dev];
29:   const cap = CAPTIONS[key];
30:   if (!cap) continue;
31:   const img = 'data:image/png;base64,' + readFileSync(join(src, f)).toString('base64');
32:   const phone = dev === 'iphone69';
33:   const capH = Math.round(H * (phone ? 0.2 : 0.17));
34:   const shotH = H - capH - Math.round(H * 0.04);
35:   const shotW = Math.round((shotH * W) / H);
36:   const fs = Math.round(W * (phone ? 0.082 : 0.058));
37:   const html = `<!doctype html><meta charset="utf-8"><style>
38:     html,body{margin:0;width:${W}px;height:${H}px;overflow:hidden}
39:     body{background:repeating-linear-gradient(90deg,#fff6e8 0 ${W / 30}px,#fdebd6 ${W / 30}px ${W / 15}px);
40:       font-family:'Hiragino Maru Gothic ProN','Yu Gothic UI','Yu Gothic','Meiryo',sans-serif;color:#4a3a40;
41:       display:flex;flex-direction:column;align-items:center}
42:     .cap{height:${capH}px;display:flex;flex-direction:column;justify-content:center;align-items:center;font-weight:800;
43:       font-size:${fs}px;line-height:1.28;letter-spacing:0.04em;text-align:center}
44:     .cap span:last-child{background:linear-gradient(transparent 62%,#ffd66b 62% 92%,transparent 92%);padding:0 0.2em}
45:     .shot{width:${shotW}px;height:${shotH}px;border-radius:${Math.round(W * 0.05)}px;overflow:hidden;
46:       border:${Math.round(W * 0.008)}px solid #4a3a40;box-shadow:0 ${Math.round(W * 0.012)}px 0 rgba(74,58,64,.25);box-sizing:border-box}
47:     .shot img{width:100%;height:100%;display:block}
48:   </style><div class="cap"><span>${cap[0]}</span><span>${cap[1]}</span></div><div class="shot"><img src="${img}"></div>`;
49:   const p = await b.newPage({ viewport: { width: W, height: H }, deviceScaleFactor: 1 });
50:   await p.setContent(html);
51:   await p.waitForTimeout(200);
52:   await p.screenshot({ path: join(out, f) });
53:   await p.close();
54: }
55: await b.close();
56: console.log(`見出し付きの画面写真を ${out} に書き出しました`);
FILE strategy/APP_STORE.md
1: # App Store 提出の下書き（もようのかくれんぼ）
2: 
3: 状態：**下書き**。App Store Connect への入力・提出はまだしていません。入力するのは持ち主です。
4: アプリの記録：App Store Connect に「もようのかくれんぼ」（iOS 1.0・提出準備中）作成済み（2026-10-08）。
5: Bundle ID：`com.akihikoito.moyoukakurenbo`（native/capacitor.config.json と Xcode の設定）
6: 
7: ---
8: 
9: ## 1. 決めてもらうこと（持ち主）
10: 
11: | # | 決めること | おすすめ | 理由 |
12: |---|---|---|---|
13: | A | 1.0 を **全部無料**で出すか、**課金（追加パック）を入れてから**出すか | まず TestFlight で家族テスト → 課金を入れてから 1.0 提出 | 今のアプリ版は「全部遊べる」設定。課金（StoreKit）はまだ作っていない。先に無料で全部出すと、あとから有料にしにくい |
14: | B | プライバシーポリシーとサポートのページをどこに置くか | My柔道と同じ GitHub Pages に置く | どちらもストア提出に必須。ページの中身は `site/privacy.html`・`site/support.html` に用意済み。**公開になる**ので持ち主の許可が必要 |
15: | C | サポートの連絡先メール | 持ち主が決める | `site/support.html` の「（連絡先）」を置き換える |
16: | D | キッズカテゴリに入れるか | 入れる（年齢帯「5歳以下」） | 小さい子向けの棚に並ぶ。条件（広告・外部分析なし、外部リンクと購入の前に保護者ゲート）はすでに満たしている。**入れた後に外すのは制限がある**ので慎重に |
17: | E | 著作権表示（©）の名前 | App Store Connect の販売者名と同じ | 例：「2026 （販売者名）」 |
18: 
19: ## 2. App 情報（日本語）
20: 
21: - **名前**（30文字まで）：もようのかくれんぼ
22: - **サブタイトル**（30文字まで）：もように まぎれた ともだちを さがそう
23: - **カテゴリ**：ゲーム（サブ：ファミリー / パズル）。キッズカテゴリは上の D
24: - **プロモーション用テキスト**（170文字まで・審査なしで変えられる）：
25:   > 新しい背景「うみべ」と、なかまの ちょきが きました。カーテンや ソファの もように まぎれた ともだちを、ゆびで タッチして みつけよう。
26: - **説明**（4000文字まで）：
27: 
28: > 部屋のカーテン、ソファ、じゅうたん。おなじ「もよう」の服をきた ともだちが、どこかに かくれています。
29: > よく見て、タッチして、みつけてね。
30: >
31: > ■ あそびかた
32: > ・さがす：背景をえらんで、かくれた ともだちを さがします。
33: > ・コースで あそぶ：10のコースを じゅんばんに。進むと ぼうしや かさで、だんだん むずかしくなります。
34: > ・かくして わたす：おうちの人や きょうだいが ともだちを かくして、こどもに わたして さがしてもらう、ふたりあそび。
35: >
36: > ■ あつめる たのしみ
37: > ・みつけるたびに シールが ふえる「シールちょう」。
38: > ・コースをクリアすると、あたらしい ともだちが なかまに。
39: >
40: > ■ 保護者の方へ
41: > ・広告はありません。外部へのリンク、アカウント登録もありません。
42: > ・通信なしで遊べます。名前・写真・位置などの個人の情報は集めません。
43: > ・設定は「おとなの かたへ」から。数字を使った確認のあとに開きます。
44: > ・学習や発達への効果をうたうものではありません。親子で楽しむ遊びとして作っています。
45: 
46: - **キーワード**（100文字まで・カンマ区切り・名前に入っている語は入れない）：
47:   `さがしもの,絵探し,幼児,子ども,こども,キッズ,未就学,親子,模様,パズル,オフライン,広告なし,ひらがな,ふたりあそび,3歳,4歳,5歳,ファミリー`（約80文字）
48:   （「知育」は効果をうたう印象になるので入れていない。ほかのアプリ名・商標は入れない）
49: - **サポートURL**：B で決めた場所の `support.html`
50: - **プライバシーポリシーURL**：B で決めた場所の `privacy.html`
51: - **著作権**：E
52: 
53: ## 3. 年齢制限（質問票の答え）
54: 
55: すべて「なし」／「いいえ」：暴力・性的な内容・恐怖・ギャンブル・アルコール等・医療・成人向けテーマ・ユーザー生成コンテンツ・ウェブ閲覧・チャット・位置共有・コンテスト、いずれも該当なし。
56: → 結果は **4+** になる見込み。
57: 
58: ## 4. App のプライバシー（栄養成分ラベル）
59: 
60: - 「データを収集していますか？」→ **いいえ（データの収集なし / Data Not Collected）**
61: - 根拠：外部へ送る処理が無い（アプリ版の www は `native/check-www.mjs` で外部URL・Service Worker が無いことを毎回確認）。保存は端末内の設定・進み具合・見つけた数だけ。
62: - 追跡（ATT）：しない。
63: 
64: ## 5. 画面写真
65: 
66: `native/store-shots/framed/` に自動で作成（`node store-shots.mjs && node store-frame.mjs`）。git には入れていない（大きいので）。
67: 
68: | 端末の欄 | 大きさ | ファイル |
69: |---|---|---|
70: | iPhone 6.9インチ | 1320×2868 | `iphone69-1〜5-*.png` |
71: | iPad 13インチ | 2064×2752 | `ipad13-1〜5-*.png` |
72: 
73: 順番：1 タイトル「もように まぎれて かくれんぼ」→ 2 コース → 3 帽子のコース → 4 うみべ → 5 シールちょう。
74: ※ うみべ は有料パック予定。課金を入れたあとは、説明に「追加パック」と書くか、4枚目を無料の背景に替える。
75: 
76: ## 6. 審査メモ（App Review への一言）
77: 
78: > 子ども向けの、もようにまぎれたキャラクターを探すゲームです。ログインは不要です。広告・外部リンク・データ収集はありません。
79: > 保護者向けの設定は、タイトル右下「おとなの かたへ」から、漢数字を小さい順に押し、ボタンを長押しすると開きます。
80: 
81: ## 7. 輸出コンプライアンス
82: 
83: 暗号化を使っていない（Info.plist に `ITSAppUsesNonExemptEncryption = false` 済み）。提出時の質問は「いいえ」。
