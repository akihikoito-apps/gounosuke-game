1: // 保護者用の領域と、偶然の操作を防ぐゲート（試作品。年齢確認や法的同意の取得ではない）。
2: import type { Store } from '../storage/storage';
3: import { resetCounters, setEnabled } from '../storage/playtest';
4: import { setSoundEnabled } from '../audio/sound';
5: import { NATIVE } from './platform';
6: 
7: const KANJI = ['〇', '一', '二', '三', '四', '五', '六', '七', '八', '九'];
8: const HOLD_MS = 2200;
9: 
10: export function makeChallenge(rand: () => number = Math.random): number[] {
11:   const pool = [1, 2, 3, 4, 5, 6, 7, 8, 9];
12:   const out: number[] = [];
13:   while (out.length < 3) {
14:     const i = Math.floor(rand() * pool.length);
15:     out.push(pool.splice(i, 1)[0]);
16:   }
17:   // 表示順は小さい順にしない（そのまま押すと失敗する）
18:   if (out[0] < out[1] && out[1] < out[2]) out.reverse();
19:   return out;
20: }
21: 
22: export class ParentArea {
23:   private store: Store;
24:   private onChange: () => void;
25:   private el: HTMLElement | null = null;
26:   private challenge: number[] = [];
27:   private progress: number[] = [];
28:   private holdTimer = 0;
29:   private returnFocus: HTMLElement | null = null;
30:   private confirmDelete = false;
31:   private keyHandler = (e: KeyboardEvent) => {
32:     if (e.key === 'Escape') this.close();
33:     if (e.key === 'Tab' && this.el) this.trapFocus(e);
34:   };
35: 
36:   private onCleared: () => void;
37:   private failures = 0;
38:   private cooldownUntil = 0;
39: 
40:   private onTrial: () => void;
41: 
42:   constructor(store: Store, onChange: () => void, onCleared: () => void = () => undefined, onTrial: () => void = () => undefined) {
43:     this.store = store;
44:     this.onChange = onChange;
45:     this.onCleared = onCleared;
46:     this.onTrial = onTrial;
47:   }
48: 
49:   isOpen(): boolean {
50:     return this.el !== null;
51:   }
52: 
53:   openGate(from?: HTMLElement): void {
54:     this.close();
55:     this.returnFocus = from ?? null;
56:     this.challenge = makeChallenge();
57:     this.progress = [];
58:     this.mount(this.gateHtml());
59:     this.bindGate();
60:   }
61: 
62:   close(): void {
63:     window.clearTimeout(this.holdTimer);
64:     if (!this.el) return;
65:     this.el.remove();
66:     this.el = null;
67:     this.confirmDelete = false;
68:     document.removeEventListener('keydown', this.keyHandler);
69:     const back = this.returnFocus?.isConnected ? this.returnFocus : document.querySelector<HTMLElement>('[data-action="parent"]');
70:     back?.focus?.({ preventScroll: true });
71:   }
72: 
73:   private mount(html: string): void {
74:     this.el?.remove();
75:     const el = document.createElement('div');
76:     el.className = 'parent-layer';
77:     el.innerHTML = html;
78:     document.body.appendChild(el);
79:     this.el = el;
80:     document.removeEventListener('keydown', this.keyHandler);
81:     document.addEventListener('keydown', this.keyHandler);
82:     el.querySelector<HTMLElement>('[data-autofocus]')?.focus({ preventScroll: true });
83:   }
84: 
85:   private trapFocus(e: KeyboardEvent): void {
86:     const f = Array.from(this.el!.querySelectorAll<HTMLElement>('button:not([disabled]), input, [tabindex="0"]'));
87:     if (f.length === 0) return;
88:     const first = f[0];
89:     const last = f[f.length - 1];
90:     if (e.shiftKey && document.activeElement === first) {
91:       e.preventDefault();
92:       last.focus();
93:     } else if (!e.shiftKey && document.activeElement === last) {
94:       e.preventDefault();
95:       first.focus();
96:     }
97:   }
98: 
99:   // ---- ゲート ----
100: 
101:   private gateHtml(msg = ''): string {
102:     const nums = this.challenge.map((n) => KANJI[n]).join('・');
103:     const keys = [1, 2, 3, 4, 5, 6, 7, 8, 9]
104:       .map((n) => `<button type="button" class="key${this.progress.includes(n) ? ' on' : ''}" data-key="${n}">${n}</button>`)
105:       .join('');
106:     return `<div class="parent-dialog gate" role="dialog" aria-modal="true" aria-labelledby="gate-title">
107:       <h2 id="gate-title">保護者の方へ</h2>
108:       <p>設定を開くには、次の漢数字を <strong>小さい順に</strong> 数字のボタンで押してください。</p>
109:       <p class="gate-nums" aria-live="polite">${nums}</p>
110:       <div class="keys" role="group" aria-label="数字">${keys}</div>
111:       <p class="gate-msg" role="status">${msg}</p>
112:       <div class="gate-hold" hidden>
113:         <p>最後に、下のボタンを約2秒 押し続けてください。</p>
114:         <button type="button" class="hold-btn" data-hold><span class="hold-fill"></span><span class="hold-lbl">押し続ける</span></button>
115:       </div>
116:       <div class="row"><button type="button" class="pbtn" data-close data-autofocus>閉じる</button></div>
117:     </div>`;
118:   }
119: 
120:   private bindGate(): void {
121:     const el = this.el!;
122:     el.querySelector('[data-close]')?.addEventListener('click', () => this.close());
123:     el.querySelectorAll<HTMLButtonElement>('[data-key]').forEach((b) =>
124:       b.addEventListener('click', () => this.onKey(Number(b.dataset.key))),
125:     );
126:   }
127: 
128:   private onKey(n: number): void {
129:     if (performance.now() < this.cooldownUntil) return; // 連打対策（保護者向け画面のみ）
130:     const want = this.challenge.slice().sort((a, b) => a - b);
131:     const next = want[this.progress.length];
132:     if (n !== next) {
133:       // 失敗：問題を作り直す（待ち時間・罰はない）
134:       this.failures++;
135:       if (this.failures % 3 === 0) this.cooldownUntil = performance.now() + 3000;
136:       this.challenge = makeChallenge();
137:       this.progress = [];
138:       this.mount(this.gateHtml(this.failures % 3 === 0 ? 'ちがいました。少し待ってから、新しい問題でもう一度どうぞ。' : 'ちがいました。新しい問題です。'));
139:       this.bindGate();
140:       return;
141:     }
142:     this.progress.push(n);
143:     this.el!.querySelector(`[data-key="${n}"]`)?.classList.add('on');
144:     if (this.progress.length === 3) this.showHold();
145:   }
146: 
147:   private showHold(): void {
148:     const el = this.el!;
149:     el.querySelectorAll<HTMLButtonElement>('[data-key]').forEach((b) => (b.disabled = true));
150:     const box = el.querySelector<HTMLElement>('.gate-hold')!;
151:     box.hidden = false;
152:     const hold = el.querySelector<HTMLButtonElement>('[data-hold]')!;
153:     hold.focus();
154:     const startHold = (e: Event) => {
155:       e.preventDefault();
156:       hold.classList.add('holding');
157:       window.clearTimeout(this.holdTimer);
158:       this.holdTimer = window.setTimeout(() => this.openPanel(), HOLD_MS);
159:     };
160:     const stopHold = () => {
161:       hold.classList.remove('holding');
162:       window.clearTimeout(this.holdTimer);
163:     };
164:     hold.addEventListener('pointerdown', startHold);
165:     hold.addEventListener('pointerup', stopHold);
166:     hold.addEventListener('pointerleave', stopHold);
167:     hold.addEventListener('pointercancel', stopHold);
168:     hold.addEventListener('contextmenu', (e) => e.preventDefault());
169:     hold.addEventListener('keydown', (e) => {
170:       if ((e.key === 'Enter' || e.key === ' ') && !e.repeat) startHold(e);
171:     });
172:     hold.addEventListener('keyup', (e) => {
173:       if (e.key === 'Enter' || e.key === ' ') stopHold();
174:     });
175:     // キーを押したまま Tab で離れる・ウィンドウを離れると keyup が届かないため、ここでも取り消す
176:     hold.addEventListener('blur', stopHold);
177:     const onWindowBlur = () => {
178:       if (!hold.isConnected) window.removeEventListener('blur', onWindowBlur);
179:       stopHold();
180:     };
181:     window.addEventListener('blur', onWindowBlur);
182:   }
183: 
