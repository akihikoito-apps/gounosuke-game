6:   setItem(k: string, v: string): void;
7:   removeItem(k: string): void;
8: }
9: 
10: export type LoadStatus = 'ok' | 'empty' | 'recovered' | 'unavailable';
11: 
12: export class Store {
13:   private kv: KV | null;
14:   data: SaveData;
15:   status: LoadStatus = 'empty';
16:   lastSaveOk = true;
17: 
18:   constructor(kv: KV | null) {
19:     this.kv = kv;
20:     this.data = defaults();
21:   }
22: 
23:   static fromWindow(): Store {
24:     let kv: KV | null = null;
25:     try {
26:       kv = window.localStorage;
27:       // アクセスできるか確認（プライベートモード等で例外になる環境がある）
28:       kv.getItem(STORAGE_KEY);
29:     } catch {
30:       kv = null;
31:     }
32:     return new Store(kv);
33:   }
34: 
35:   load(): SaveData {
36:     if (!this.kv) {
37:       this.status = 'unavailable';
38:       this.data = defaults();
39:       return this.data;
40:     }
41:     let raw: string | null = null;
42:     try {
43:       raw = this.kv.getItem(STORAGE_KEY);
44:     } catch {
45:       this.status = 'unavailable';
46:       this.data = defaults();
47:       return this.data;
48:     }
49:     if (raw === null) {
50:       this.status = 'empty';
51:       this.data = defaults();
52:       return this.data;
53:     }
54:     let parsed: unknown;
55:     try {
56:       parsed = JSON.parse(raw);
57:     } catch {
58:       parsed = undefined;
59:     }
60:     const { data, repaired } = validate(parsed);
61:     this.data = data;
62:     this.status = repaired ? 'recovered' : 'ok';
63:     if (repaired) this.save(); // 直した内容で上書き（壊れた値を残さない）
64:     return this.data;
65:   }
66: 
67:   save(): boolean {
68:     if (!this.kv) {
69:       this.lastSaveOk = false;
70:       return false;
71:     }
72:     try {
73:       this.kv.setItem(STORAGE_KEY, JSON.stringify(this.data));
74:       this.lastSaveOk = true;
75:     } catch {
76:       // 容量不足など。メモリ上の状態のまま遊び続けられる。
77:       this.lastSaveOk = false;
78:     }
79:     return this.lastSaveOk;
80:   }
81: 
82:   update(fn: (d: SaveData) => void): boolean {
83:     fn(this.data);
84:     return this.save();
85:   }
86: 
87:   /** このアプリのデータだけを消す */
88:   clearAll(): boolean {
89:     this.data = defaults();
90:     if (!this.kv) return false;
91:     try {
92:       this.kv.removeItem(STORAGE_KEY);
93:       this.status = 'empty';
94:       this.lastSaveOk = true;
95:       return true;
96:     } catch {
97:       return false;
98:     }
99:   }
100: }
101: 
102: export class MemoryKV implements KV {
103:   map = new Map<string, string>();
104:   failWrites = false;
105:   failReads = false;
106:   getItem(k: string): string | null {
107:     if (this.failReads) throw new Error('read blocked');
108:     return this.map.has(k) ? (this.map.get(k) as string) : null;
109:   }
110:   setItem(k: string, v: string): void {
111:     if (this.failWrites) throw new DOMException('quota', 'QuotaExceededError');
112:     this.map.set(k, v);
113:   }
114:   removeItem(k: string): void {
115:     this.map.delete(k);
116:   }
117: }
