FILE ../.github/workflows/ios-moyou.yml
1: name: iOS もようのかくれんぼ → TestFlight
2: 
3: # GitHub の macOS 環境でビルドし、App Store Connect（TestFlight）へ直接アップロードします。
4: # Mac は不要です。公開リポジトリなので macOS ランナーの利用料はかかりません。
5: # 手順は My柔道（judo-repo の ios-player.yml）と同じ。違いはフォルダと Node の版だけ。
6: #
7: # 必要な GitHub シークレット（このリポジトリの Settings › Secrets and variables › Actions）
8: #   ASC_KEY_ID     … App Store Connect API キーの「キーID」
9: #   ASC_ISSUER_ID  … 同じページ上部にある「Issuer ID」
10: #   ASC_KEY_P8     … ダウンロードした .p8 ファイルの中身をそのまま貼り付け
11: #   APPLE_TEAM_ID  … Apple Developer の Membership にある「Team ID」
12: #   ※ My柔道 と同じ値でよい（同じ Apple アカウント）。
13: #
14: # 【いつ走るか】「出すと決めたとき」だけ。moyou-vX.Y という名札（タグ）を付けて push する。
15: #     例)  git tag moyou-v1.0 && git push origin moyou-v1.0
16: #   ※ このファイルは main ではなく claude/pattern-hide-family-beta にあるので、
17: #     GitHub の画面からの手動実行（workflow_dispatch）は main に入るまで出てこない。タグで動かす。
18: on:
19:   workflow_dispatch:
20:   push:
21:     tags:
22:       - 'moyou-v*'
23: 
24: concurrency:
25:   group: ios-moyou
26:   cancel-in-progress: false
27: 
28: jobs:
29:   build:
30:     runs-on: macos-26
31:     timeout-minutes: 60
32:     env:
33:       GAME_DIR: pattern-hide-family-beta
34:       APP_DIR: pattern-hide-family-beta/native
35:       WORKSPACE: pattern-hide-family-beta/native/ios/App/App.xcworkspace
36:       PBXPROJ: pattern-hide-family-beta/native/ios/App/App.xcodeproj/project.pbxproj
37:       ARCHIVE: /tmp/App.xcarchive
38:       KEYDIR: /tmp/private_keys
39: 
40:     steps:
41:       - name: リポジトリを取得
42:         uses: actions/checkout@v4
43: 
44:       - name: シークレットが入っているか先に確認
45:         env:
46:           ASC_KEY_ID: ${{ secrets.ASC_KEY_ID }}
47:           ASC_ISSUER_ID: ${{ secrets.ASC_ISSUER_ID }}
48:           ASC_KEY_P8: ${{ secrets.ASC_KEY_P8 }}
49:           APPLE_TEAM_ID: ${{ secrets.APPLE_TEAM_ID }}
50:         run: |
51:           ng=0
52:           check() { if [ -z "$2" ]; then echo "::error::シークレット $1 が未設定です"; ng=1; else echo "$1 … OK (${#2}文字)"; fi; }
53:           check ASC_KEY_ID    "$ASC_KEY_ID"
54:           check ASC_ISSUER_ID "$ASC_ISSUER_ID"
55:           check ASC_KEY_P8    "$ASC_KEY_P8"
56:           check APPLE_TEAM_ID "$APPLE_TEAM_ID"
57:           case "$ASC_KEY_P8" in
58:             *"BEGIN PRIVATE KEY"*) echo "ASC_KEY_P8 … 鍵の形式OK" ;;
59:             *) echo "::error::ASC_KEY_P8 に -----BEGIN PRIVATE KEY----- が見当たりません。.p8の中身を全文貼り直してください"; ng=1 ;;
60:           esac
61:           exit $ng
62: 
63:       - name: 入っている Xcode のうち最新を選ぶ
64:         run: |
65:           latest=$(ls -d /Applications/Xcode*.app 2>/dev/null | sort -V | tail -1)
66:           if [ -n "$latest" ]; then
67:             echo "選択: $latest"
68:             sudo xcode-select -s "$latest/Contents/Developer"
69:           fi
70:           xcodebuild -version
71:           pod --version
72:           sdk=$(xcodebuild -showsdks | grep -o 'iphoneos[0-9.]*' | tail -1)
73:           echo "::notice::使用Xcode=$(xcodebuild -version | head -1) / SDK=${sdk}"
74: 
75:       - name: Node.js を用意
76:         uses: actions/setup-node@v4
77:         with:
78:           node-version: '22'
79:           cache: npm
80:           cache-dependency-path: |
81:             pattern-hide-family-beta/package-lock.json
82:             pattern-hide-family-beta/native/package-lock.json
83: 
84:       - name: 依存パッケージを入れる（ゲーム本体と iOS の入れ物）
85:         run: |
86:           npm ci --no-audit --no-fund --prefix "$GAME_DIR"
87:           npm ci --no-audit --no-fund --prefix "$APP_DIR"
88: 
89:       - name: ゲーム本体の単体テスト（壊れたものは出さない）
90:         working-directory: pattern-hide-family-beta
91:         run: npm test
92: 
93:       - name: ビルド番号を設定（GitHub の実行番号を使う）
94:         run: |
95:           sed -i '' "s/CURRENT_PROJECT_VERSION = [0-9]*;/CURRENT_PROJECT_VERSION = ${{ github.run_number }};/g" "$PBXPROJ"
96:           MV=$(grep -m1 MARKETING_VERSION "$PBXPROJ" | tr -d " 	;" | cut -d= -f2)
97:           echo "::notice::このビルドは $MV (${{ github.run_number }}) です"
98:           echo "※ App Store で公開済みのバージョン番号は使えません。公開したら MARKETING_VERSION を上げてください。"
99: 
100:       - name: www を作って iOS 側へ同期（pod install もここで走る）
101:         working-directory: pattern-hide-family-beta/native
102:         run: |
103:           node build-www.mjs
104:           node check-www.mjs   # 外部通信なし・Service Worker なし・テスト版の表示なし
105:           npx cap sync ios
106:           test -f ios/App/Podfile.lock || { echo "::error::Podfile.lock がありません（pod install が走っていません）"; exit 1; }
107:           test -d ios/App/Pods         || { echo "::error::Pods ディレクトリがありません"; exit 1; }
108: 
109:       - name: App Store Connect の API キーを書き出す
110:         env:
111:           ASC_KEY_P8: ${{ secrets.ASC_KEY_P8 }}
112:           ASC_KEY_ID: ${{ secrets.ASC_KEY_ID }}
113:         run: |
114:           mkdir -p "$KEYDIR"
115:           printf '%s\n' "$ASC_KEY_P8" > "$KEYDIR/AuthKey_${ASC_KEY_ID}.p8"
116:           chmod 600 "$KEYDIR/AuthKey_${ASC_KEY_ID}.p8"
117: 
118:       - name: 署名設定を整える（チームID・固定 identity の除去）
119:         env:
120:           APPLE_TEAM_ID: ${{ secrets.APPLE_TEAM_ID }}
121:         run: node "$APP_DIR/ci-set-team.cjs"
122: 
123:       - name: アーカイブ（署名はここではせず、書き出し時に配布用で署名する）
124:         env:
125:           ASC_KEY_ID: ${{ secrets.ASC_KEY_ID }}
126:           ASC_ISSUER_ID: ${{ secrets.ASC_ISSUER_ID }}
127:         run: |
128:           set +e
129:           xcodebuild archive \
130:             -workspace "$WORKSPACE" \
131:             -scheme App \
132:             -configuration Release \
133:             -destination 'generic/platform=iOS' \
134:             -archivePath "$ARCHIVE" \
135:             -allowProvisioningUpdates \
136:             -authenticationKeyPath "$KEYDIR/AuthKey_${ASC_KEY_ID}.p8" \
137:             -authenticationKeyID "$ASC_KEY_ID" \
138:             -authenticationKeyIssuerID "$ASC_ISSUER_ID" \
139:             CODE_SIGNING_ALLOWED=NO \
140:             CODE_SIGNING_REQUIRED=NO \
141:             CODE_SIGN_IDENTITY="" \
142:             2>&1 | tee /tmp/archive.log
143:           code=${PIPESTATUS[0]}
144:           if [ "$code" -ne 0 ]; then
145:             grep -aE "error:|No profiles|No signing certificate|requires a development team|Communication with Apple|Provisioning profile|Failed to (register|create)|Unable to|not available" /tmp/archive.log | tail -10 > /tmp/errs.txt
146:             [ -s /tmp/errs.txt ] || tail -10 /tmp/archive.log > /tmp/errs.txt
147:             while IFS= read -r line; do echo "::error::ARCHIVE $(printf '%s' "$line" | tr -d '\r' | cut -c1-400)"; done < /tmp/errs.txt
148:           fi
149:           exit $code
150: 
151:       - name: 失敗時：ビルドログを保存
152:         if: failure()
153:         uses: actions/upload-artifact@v4
154:         with:
155:           name: moyou-archive-log
156:           path: /tmp/archive.log
157:           if-no-files-found: ignore
158:           retention-days: 7
159: 
160:       - name: 書き出し設定を作る
161:         env:
162:           APPLE_TEAM_ID: ${{ secrets.APPLE_TEAM_ID }}
163:         run: |
164:           cat > /tmp/ExportOptions.plist <<PLIST
165:           <?xml version="1.0" encoding="UTF-8"?>
166:           <!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
167:           <plist version="1.0">
168:           <dict>
169:             <key>method</key><string>app-store-connect</string>
170:             <key>destination</key><string>upload</string>
171:             <key>teamID</key><string>${APPLE_TEAM_ID}</string>
172:             <key>signingStyle</key><string>automatic</string>
173:             <key>uploadSymbols</key><true/>
174:             <key>manageAppVersionAndBuildNumber</key><false/>
175:           </dict>
176:           </plist>
177:           PLIST
178: 
179:       - name: 配布用に署名して TestFlight へアップロード
180:         env:
181:           ASC_KEY_ID: ${{ secrets.ASC_KEY_ID }}
182:           ASC_ISSUER_ID: ${{ secrets.ASC_ISSUER_ID }}
183:         run: |
184:           set +e
185:           xcodebuild -exportArchive \
186:             -archivePath "$ARCHIVE" \
187:             -exportOptionsPlist /tmp/ExportOptions.plist \
188:             -exportPath /tmp/export \
189:             -allowProvisioningUpdates \
190:             -authenticationKeyPath "$KEYDIR/AuthKey_${ASC_KEY_ID}.p8" \
191:             -authenticationKeyID "$ASC_KEY_ID" \
192:             -authenticationKeyIssuerID "$ASC_ISSUER_ID" \
193:             2>&1 | tee /tmp/export.log
194:           code=${PIPESTATUS[0]}
195:           if [ "$code" -ne 0 ]; then
196:             grep -aE "error:|No profiles|No signing certificate|Communication with Apple|Provisioning profile|Failed to|Unable to|not available|denied" /tmp/export.log | tail -10 > /tmp/eerrs.txt
197:             [ -s /tmp/eerrs.txt ] || tail -10 /tmp/export.log > /tmp/eerrs.txt
198:             while IFS= read -r line; do echo "::error::EXPORT $(printf '%s' "$line" | tr -d '\r' | cut -c1-400)"; done < /tmp/eerrs.txt
199:           fi
200:           exit $code
201: 
202:       - name: 失敗時：書き出しログを保存
203:         if: failure()
204:         uses: actions/upload-artifact@v4
205:         with:
206:           name: moyou-export-log
207:           path: /tmp/export.log
208:           if-no-files-found: ignore
209:           retention-days: 7
210: 
211:       - name: 完了メッセージ
212:         run: echo "TestFlight へのアップロードが完了しました。処理に5〜15分かかることがあります。"
