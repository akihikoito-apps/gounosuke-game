552: 
553: private extension WKURLSchemeTask {
554:     var stopped: Bool {
555:         get {
556:             return objc_getAssociatedObject(self, &stoppedKey) as? Bool ?? false
557:         }
558:         set {
559:             objc_setAssociatedObject(self, &stoppedKey, newValue, .OBJC_ASSOCIATION_ASSIGN)
560:         }
561:     }
562: }
FILE src/audio/sound.ts
1: // 端末内で生成する短い音だけを使う（音声ファイル・外部取得なし）。
2: // ユーザー操作より前には鳴らさない。消音できる。
3: type Tone = 'pop' | 'found' | 'soft' | 'clear';
4: 
5: let ctx: AudioContext | null = null;
6: let unlocked = false;
7: let enabled = true;
8: 
9: export function setSoundEnabled(v: boolean): void {
10:   enabled = v;
11:   if (!v && ctx) void ctx.suspend().catch(() => undefined);
12: }
13: 
14: /** 最初のユーザー操作で呼ぶ */
15: export function unlockAudio(): void {
16:   unlocked = true;
17: }
18: 
19: function getCtx(): AudioContext | null {
20:   if (!unlocked || !enabled) return null;
21:   try {
22:     const AC = window.AudioContext ?? (window as unknown as { webkitAudioContext?: typeof AudioContext }).webkitAudioContext;
23:     if (!AC) return null;
