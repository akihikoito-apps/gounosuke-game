body { overflow: hidden; touch-action: manipulation; }
.app {
  position: fixed;
  inset: 0;
  height: 100vh;
  height: 100dvh;
  padding: var(--safe-t) var(--safe-r) var(--safe-b) var(--safe-l);
  user-select: none;
  -webkit-user-select: none;
  -webkit-touch-callout: none;
}
.screen { width: 100%; height: 100%; display: flex; flex-direction: column; align-items: center; gap: 12px; padding: 10px; }
h1, h2, h3, p { margin: 0; }
h2 { font-size: clamp(20px, 5vw, 30px); text-align: center; }

/* ---- ボタン ---- */
.btn {
  display: inline-flex; align-items: center; justify-content: center; gap: 10px;
