  font: inherit; font-weight: 700; font-size: 20px;
  box-shadow: 0 5px 0 rgba(74, 58, 64, 0.25);
  cursor: pointer; touch-action: manipulation;
}
.btn:active { transform: translateY(3px); box-shadow: 0 2px 0 rgba(74, 58, 64, 0.25); }
.btn:disabled { opacity: 0.35; cursor: default; }
.btn:focus-visible, .scene-card:focus-visible, .char-card:focus-visible, .swatch:focus-visible, .tray-char:focus-visible, .tab:focus-visible {
  outline: 5px solid #5b8def; outline-offset: 3px;
}
.btn .icon { width: 40px; height: 40px; flex: none; }
.btn.big { min-height: 96px; font-size: 26px; border-radius: 30px; width: min(420px, 86vw); }
.btn.big .icon { width: 60px; height: 60px; }
.btn.mid { min-height: 72px; font-size: 21px; }
.btn.primary { background: var(--primary); }
.btn.secondary { background: var(--secondary); }
