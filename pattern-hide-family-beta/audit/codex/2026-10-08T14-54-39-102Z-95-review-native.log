1: import './ui/styles.css';
2: import { App } from './ui/app';
3: import { Store } from './storage/storage';
4: 
5: const store = Store.fromWindow();
6: store.load();
7: const root = document.getElementById('app') as HTMLElement;
8: const app = new App(root, store);
9: app.start();
10: 
11: // 自動テスト用の読み取り窓口。開発時と e2e 用ビルド（--mode e2e）だけに入る。
12: // 通常のビルドには含めない（受け渡し中に隠れ場所を読めてしまうため）。
13: if (import.meta.env.DEV || import.meta.env.MODE === 'e2e') {
14:   (window as unknown as { __game: unknown }).__game = { state: () => app.debugState(), storeStatus: () => store.status };
15: }
16: 
17: // オフライン用 Service Worker：本番ビルドかつ安全なコンテキスト（HTTPS/localhost）のときだけ
18: // iOS アプリ（--mode native）では使わない（アプリの中に絵がすべて入っている）
19: if (import.meta.env.PROD && import.meta.env.MODE !== 'native' && 'serviceWorker' in navigator && window.isSecureContext) {
20:   window.addEventListener('load', () => {
21:     navigator.serviceWorker.register('./sw.js').catch(() => undefined);
22:   });
23: }
