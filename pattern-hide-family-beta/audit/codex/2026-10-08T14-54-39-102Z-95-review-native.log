58:     g.gain.exponentialRampToValueAtTime(0.12, at + 0.015);
59:     g.gain.exponentialRampToValueAtTime(0.0001, at + d);
60:     o.connect(g).connect(c.destination);
61:     o.start(at);
62:     o.stop(at + d + 0.02);
63:     at += d * 0.9;
64:   }
65: }
