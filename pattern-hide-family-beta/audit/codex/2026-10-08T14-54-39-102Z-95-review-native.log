name: iOS もようのかくれんぼ → TestFlight

# GitHub の macOS 環境でビルドし、App Store Connect（TestFlight）へ直接アップロードします。
# Mac は不要です。公開リポジトリなので macOS ランナーの利用料はかかりません。
# 手順は My柔道（judo-repo の ios-player.yml）と同じ。違いはフォルダと Node の版だけ。
#
# 必要な GitHub シークレット（このリポジトリの Settings › Secrets and variables › Actions）
#   ASC_KEY_ID     … App Store Connect API キーの「キーID」
#   ASC_ISSUER_ID  … 同じページ上部にある「Issuer ID」
#   ASC_KEY_P8     … ダウンロードした .p8 ファイルの中身をそのまま貼り付け
#   APPLE_TEAM_ID  … Apple Developer の Membership にある「Team ID」
#   ※ My柔道 と同じ値でよい（同じ Apple アカウント）。
#
# 【いつ走るか】「出すと決めたとき」だけ。moyou-vX.Y という名札（タグ）を付けて push する。
#     例)  git tag moyou-v1.0 && git push origin moyou-v1.0
#   ※ このファイルは main ではなく claude/pattern-hide-family-beta にあるので、
#     GitHub の画面からの手動実行（workflow_dispatch）は main に入るまで出てこない。タグで動かす。
on:
  workflow_dispatch:
  push:
    tags:
      - 'moyou-v*'

concurrency:
  group: ios-moyou
  cancel-in-progress: false

jobs:
  build:
    runs-on: macos-26
    timeout-minutes: 60
    env:
      GAME_DIR: pattern-hide-family-beta
      APP_DIR: pattern-hide-family-beta/native
      WORKSPACE: pattern-hide-family-beta/native/ios/App/App.xcworkspace
      PBXPROJ: pattern-hide-family-beta/native/ios/App/App.xcodeproj/project.pbxproj
      ARCHIVE: /tmp/App.xcarchive
      KEYDIR: /tmp/private_keys

    steps:
      - name: リポジトリを取得
        uses: actions/checkout@v4

      - name: シークレットが入っているか先に確認
        env:
          ASC_KEY_ID: ${{ secrets.ASC_KEY_ID }}
          ASC_ISSUER_ID: ${{ secrets.ASC_ISSUER_ID }}
          ASC_KEY_P8: ${{ secrets.ASC_KEY_P8 }}
          APPLE_TEAM_ID: ${{ secrets.APPLE_TEAM_ID }}
        run: |
          ng=0
          check() { if [ -z "$2" ]; then echo "::error::シークレット $1 が未設定です"; ng=1; else echo "$1 … OK (${#2}文字)"; fi; }
          check ASC_KEY_ID    "$ASC_KEY_ID"
          check ASC_ISSUER_ID "$ASC_ISSUER_ID"
          check ASC_KEY_P8    "$ASC_KEY_P8"
          check APPLE_TEAM_ID "$APPLE_TEAM_ID"
          case "$ASC_KEY_P8" in
            *"BEGIN PRIVATE KEY"*) echo "ASC_KEY_P8 … 鍵の形式OK" ;;
            *) echo "::error::ASC_KEY_P8 に -----BEGIN PRIVATE KEY----- が見当たりません。.p8の中身を全文貼り直してください"; ng=1 ;;
          esac
          exit $ng

      - name: 入っている Xcode のうち最新を選ぶ
        run: |
          latest=$(ls -d /Applications/Xcode*.app 2>/dev/null | sort -V | tail -1)
          if [ -n "$latest" ]; then
            echo "選択: $latest"
            sudo xcode-select -s "$latest/Contents/Developer"
          fi
          xcodebuild -version
          pod --version
          sdk=$(xcodebuild -showsdks | grep -o 'iphoneos[0-9.]*' | tail -1)
          echo "::notice::使用Xcode=$(xcodebuild -version | head -1) / SDK=${sdk}"

      - name: Node.js を用意
        uses: actions/setup-node@v4
        with:
          node-version: '22'
          cache: npm
          cache-dependency-path: |
            pattern-hide-family-beta/package-lock.json
            pattern-hide-family-beta/native/package-lock.json

      - name: 依存パッケージを入れる（ゲーム本体と iOS の入れ物）
        run: |
          npm ci --no-audit --no-fund --prefix "$GAME_DIR"
          npm ci --no-audit --no-fund --prefix "$APP_DIR"

      - name: ゲーム本体の単体テスト（壊れたものは出さない）
        working-directory: pattern-hide-family-beta
        run: npm test

      - name: ビルド番号を設定（GitHub の実行番号を使う）
        run: |
          sed -i '' "s/CURRENT_PROJECT_VERSION = [0-9]*;/CURRENT_PROJECT_VERSION = ${{ github.run_number }};/g" "$PBXPROJ"
          MV=$(grep -m1 MARKETING_VERSION "$PBXPROJ" | tr -d " 	;" | cut -d= -f2)
          echo "::notice::このビルドは $MV (${{ github.run_number }}) です"
          echo "※ App Store で公開済みのバージョン番号は使えません。公開したら MARKETING_VERSION を上げてください。"

      - name: www を作って iOS 側へ同期（pod install もここで走る）
        working-directory: pattern-hide-family-beta/native
        run: |
          node build-www.mjs
          node check-www.mjs   # 外部通信なし・Service Worker なし・テスト版の表示なし
          npx cap sync ios
          test -f ios/App/Podfile.lock || { echo "::error::Podfile.lock がありません（pod install が走っていません）"; exit 1; }
          test -d ios/App/Pods         || { echo "::error::Pods ディレクトリがありません"; exit 1; }

      - name: App Store Connect の API キーを書き出す
        env:
          ASC_KEY_P8: ${{ secrets.ASC_KEY_P8 }}
          ASC_KEY_ID: ${{ secrets.ASC_KEY_ID }}
        run: |
          mkdir -p "$KEYDIR"
          printf '%s\n' "$ASC_KEY_P8" > "$KEYDIR/AuthKey_${ASC_KEY_ID}.p8"
          chmod 600 "$KEYDIR/AuthKey_${ASC_KEY_ID}.p8"

      - name: 署名設定を整える（チームID・固定 identity の除去）
        env:
          APPLE_TEAM_ID: ${{ secrets.APPLE_TEAM_ID }}
        run: node "$APP_DIR/ci-set-team.cjs"

      - name: アーカイブ（署名はここではせず、書き出し時に配布用で署名する）
        env:
          ASC_KEY_ID: ${{ secrets.ASC_KEY_ID }}
          ASC_ISSUER_ID: ${{ secrets.ASC_ISSUER_ID }}
        run: |
          set +e
          xcodebuild archive \
            -workspace "$WORKSPACE" \
            -scheme App \
            -configuration Release \
            -destination 'generic/platform=iOS' \
            -archivePath "$ARCHIVE" \
            -allowProvisioningUpdates \
            -authenticationKeyPath "$KEYDIR/AuthKey_${ASC_KEY_ID}.p8" \
            -authenticationKeyID "$ASC_KEY_ID" \
            -authenticationKeyIssuerID "$ASC_ISSUER_ID" \
            CODE_SIGNING_ALLOWED=NO \
            CODE_SIGNING_REQUIRED=NO \
            CODE_SIGN_IDENTITY="" \
            2>&1 | tee /tmp/archive.log
          code=${PIPESTATUS[0]}
          if [ "$code" -ne 0 ]; then
            grep -aE "error:|No profiles|No signing certificate|requires a development team|Communication with Apple|Provisioning profile|Failed to (register|create)|Unable to|not available" /tmp/archive.log | tail -10 > /tmp/errs.txt
            [ -s /tmp/errs.txt ] || tail -10 /tmp/archive.log > /tmp/errs.txt
            while IFS= read -r line; do echo "::error::ARCHIVE $(printf '%s' "$line" | tr -d '\r' | cut -c1-400)"; done < /tmp/errs.txt
          fi
          exit $code

      - name: 失敗時：ビルドログを保存
        if: failure()
        uses: actions/upload-artifact@v4
        with:
          name: moyou-archive-log
          path: /tmp/archive.log
          if-no-files-found: ignore
          retention-days: 7

      - name: 書き出し設定を作る
        env:
          APPLE_TEAM_ID: ${{ secrets.APPLE_TEAM_ID }}
        run: |
          cat > /tmp/ExportOptions.plist <<PLIST
          <?xml version="1.0" encoding="UTF-8"?>
          <!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
          <plist version="1.0">
          <dict>
            <key>method</key><string>app-store-connect</string>
            <key>destination</key><string>upload</string>
            <key>teamID</key><string>${APPLE_TEAM_ID}</string>
            <key>signingStyle</key><string>automatic</string>
            <key>uploadSymbols</key><true/>
            <key>manageAppVersionAndBuildNumber</key><false/>
          </dict>
          </plist>
          PLIST

      - name: 配布用に署名して TestFlight へアップロード
        env:
          ASC_KEY_ID: ${{ secrets.ASC_KEY_ID }}
          ASC_ISSUER_ID: ${{ secrets.ASC_ISSUER_ID }}
        run: |
          set +e
          xcodebuild -exportArchive \
            -archivePath "$ARCHIVE" \
            -exportOptionsPlist /tmp/ExportOptions.plist \
            -exportPath /tmp/export \
            -allowProvisioningUpdates \
            -authenticationKeyPath "$KEYDIR/AuthKey_${ASC_KEY_ID}.p8" \
            -authenticationKeyID "$ASC_KEY_ID" \
            -authenticationKeyIssuerID "$ASC_ISSUER_ID" \
            2>&1 | tee /tmp/export.log
          code=${PIPESTATUS[0]}
          if [ "$code" -ne 0 ]; then
            grep -aE "error:|No profiles|No signing certificate|Communication with Apple|Provisioning profile|Failed to|Unable to|not available|denied" /tmp/export.log | tail -10 > /tmp/eerrs.txt
            [ -s /tmp/eerrs.txt ] || tail -10 /tmp/export.log > /tmp/eerrs.txt
            while IFS= read -r line; do echo "::error::EXPORT $(printf '%s' "$line" | tr -d '\r' | cut -c1-400)"; done < /tmp/eerrs.txt
          fi
          exit $code

      - name: 失敗時：書き出しログを保存
        if: failure()
        uses: actions/upload-artifact@v4
        with:
          name: moyou-export-log
          path: /tmp/export.log
          if-no-files-found: ignore
          retention-days: 7

      - name: 完了メッセージ
        run: echo "TestFlight へのアップロードが完了しました。処理に5〜15分かかることがあります。"
