FILE native/ci-set-team.cjs
1: /* CI用：Xcodeプロジェクトの署名設定をApp Store配布向けに整える。
2:    使い方: node ci-set-team.cjs  （環境変数 APPLE_TEAM_ID を参照。My柔道 の native/ci-set-team.js と同じ処理）
3: 
4:    1) DEVELOPMENT_TEAM を Appターゲットにだけ書き込む
5:       xcodebuild のコマンドラインで渡すと Pods の全ターゲットにも適用され、署名で転ぶことがあるため。
6: 
7:    2) CODE_SIGN_IDENTITY の固定を外す
8:       Capacitorの初期テンプレートは Debug/Release とも "iPhone Developer" に固定している。
9:       自動署名（CODE_SIGN_STYLE = Automatic）と併用すると
10:       「conflicting provisioning settings」で失敗するため、指定そのものを取り除いて
11:       Xcodeに任せる。実際の署名はアーカイブ時ではなく、書き出し（-exportArchive）時に
12:       配布用の証明書で行う。
13: */
14: const fs = require('fs');
15: const path = require('path');
16: 
17: const app = 'moyou';
18: const team = (process.env.APPLE_TEAM_ID || '').trim();
19: if (!team) { console.error('APPLE_TEAM_ID が空です'); process.exit(1); }
20: 
21: const p = path.join(__dirname, 'ios/App/App.xcodeproj/project.pbxproj');
22: let t = fs.readFileSync(p, 'utf8');
23: 
24: /* --- 1) DEVELOPMENT_TEAM --- */
25: if (/DEVELOPMENT_TEAM = [^;]*;/.test(t)) {
26:   t = t.replace(/DEVELOPMENT_TEAM = [^;]*;/g, 'DEVELOPMENT_TEAM = ' + team + ';');
27: } else {
28:   if (!/CODE_SIGN_STYLE = Automatic;/.test(t)) {
29:     console.error('CODE_SIGN_STYLE = Automatic; が見つかりません'); process.exit(1);
30:   }
31:   t = t.replace(/CODE_SIGN_STYLE = Automatic;/g,
32:     'CODE_SIGN_STYLE = Automatic;\n\t\t\t\tDEVELOPMENT_TEAM = ' + team + ';');
33: }
34: 
35: /* --- 2) CODE_SIGN_IDENTITY の行を丸ごと削除（前後の改行・インデントごと） --- */
36: const removed = (t.match(/^[ \t]*CODE_SIGN_IDENTITY = "[^"]*";[ \t]*\r?\n/gm) || []).length;
37: t = t.replace(/^[ \t]*CODE_SIGN_IDENTITY = "[^"]*";[ \t]*\r?\n/gm, '');
38: 
39: /* --- 3) 手動指定のプロファイルが残っていれば消す --- */
40: const removedProf = (t.match(/^[ \t]*PROVISIONING_PROFILE_SPECIFIER = [^;]*;[ \t]*\r?\n/gm) || []).length;
41: t = t.replace(/^[ \t]*PROVISIONING_PROFILE_SPECIFIER = [^;]*;[ \t]*\r?\n/gm, '');
42: 
43: fs.writeFileSync(p, t);
44: 
45: const teams = [...t.matchAll(/DEVELOPMENT_TEAM = ([^;]*);/g)].map(m => m[1].trim());
46: console.log(app + ': DEVELOPMENT_TEAM=' + teams.length + '箇所（' +
47:   (teams[0] ? teams[0].slice(0, 4) + '******' : '?') + '） / ' +
48:   'CODE_SIGN_IDENTITY の固定を削除=' + removed + '箇所 / ' +
49:   'PROVISIONING_PROFILE_SPECIFIER の削除=' + removedProf + '箇所');
50: if (/CODE_SIGN_IDENTITY/.test(t)) {
51:   console.log('::warning::CODE_SIGN_IDENTITY がまだ残っています');
52: }
FILE native/check-www.mjs
1: // iPhone アプリ版（www）の出荷前チェック。build-www.mjs のあとに走らせる。
2: // 使い方（native フォルダで）: node check-www.mjs
3: import { readdirSync, readFileSync, statSync, existsSync } from 'node:fs';
4: import { join, extname } from 'node:path';
5: 
6: const www = new URL('./www/', import.meta.url).pathname.replace(/^\/([A-Za-z]:)/, '$1');
7: const ng = [];
8: const files = [];
9: const walk = (d) => { for (const n of readdirSync(d)) { const p = join(d, n); statSync(p).isDirectory() ? walk(p) : files.push(p); } };
10: if (!existsSync(join(www, 'index.html'))) { console.error('www/index.html がありません。先に node build-www.mjs を実行してください'); process.exit(1); }
11: walk(www);
12: 
13: // 1. オフライン用の Service Worker はアプリ版に入れない
14: if (files.some((f) => /(^|[\/])sw\.js$/.test(f))) ng.push('Service Worker（sw.js）が入っています');
15: // 2. 外部への通信先が無い（SVG の名前空間だけは許す）
16: const allowed = new Set(['http://www.w3.org/2000/svg', 'http://www.w3.org/1999/xlink']);
17: for (const f of files.filter((f) => ['.html', '.js', '.css', '.svg', '.webmanifest'].includes(extname(f)))) {
18:   for (const u of readFileSync(f, 'utf8').match(/https?:\/\/[^\s"'`)<>]+/g) ?? []) if (!allowed.has(u)) ng.push(`外部URL ${u}（${f.slice(www.length)}）`);
19: }
20: const html = readFileSync(join(www, 'index.html'), 'utf8');
21: const js = files.filter((f) => f.endsWith('.js')).map((f) => readFileSync(f, 'utf8')).join('\n');
22: // 3. 通信先を同じ場所に限る設定がある
23: if (!/Content-Security-Policy[^>]*default-src 'self'/.test(html)) ng.push('Content-Security-Policy が見当たりません');
24: // 4. テスト版の表示・開発用の入口が残っていない
25: if (js.includes('かりの なまえ')) ng.push('「かぞく テスト ばん（かりの なまえ）」が残っています');
26: if (js.includes('__game')) ng.push('開発用の __game が残っています');
27: // 5. 大きさ（目安 30MB 以下）
28: const size = files.reduce((s, f) => s + statSync(f).size, 0);
29: if (size > 30 * 1024 * 1024) ng.push(`www が大きすぎます（${(size / 1048576).toFixed(1)}MB）`);
30: 
31: if (ng.length) { for (const m of ng) console.error('NG: ' + m); process.exit(1); }
32: console.log(`www チェック合格（${files.length}ファイル・${(size / 1048576).toFixed(1)}MB・外部通信なし・SWなし・テスト版表示なし）`);
FILE vite.config.ts
1: import { defineConfig, type Plugin } from 'vite';
2: import { createHash } from 'node:crypto';
3: import { readdirSync, readFileSync, statSync, writeFileSync } from 'node:fs';
4: import { dirname, join, relative, resolve } from 'node:path';
5: import { fileURLToPath } from 'node:url';
6: 
7: const ROOT = dirname(fileURLToPath(import.meta.url));
8: 
9: // 本番ビルドの後に、ビルド成果物の一覧から Service Worker を作る。
10: // 版（VERSION）は成果物の内容のハッシュなので、更新すると古いキャッシュは消える。
11: function serviceWorkerPlugin(): Plugin {
12:   let outDir = 'dist';
13:   return {
14:     name: 'local-service-worker',
15:     // iOS アプリ用（--mode native）では作らない
16:     apply: (_c, env) => env.command === 'build' && env.mode !== 'native',
17:     configResolved(c) {
18:       outDir = resolve(c.root, c.build.outDir);
19:     },
20:     closeBundle() {
21:       const files: string[] = [];
22:       const walk = (d: string) => {
23:         for (const f of readdirSync(d)) {
24:           const p = join(d, f);
25:           if (statSync(p).isDirectory()) walk(p);
26:           else files.push(p);
27:         }
28:       };
29:       walk(outDir);
30:       const list = files
31:         .map((f) => relative(outDir, f).split('\\').join('/'))
32:         .filter((f) => f !== 'sw.js')
33:         .sort();
34:       const h = createHash('sha256');
35:       for (const f of list) h.update(f).update(readFileSync(join(outDir, f)));
36:       const version = h.digest('hex').slice(0, 12);
37:       const tpl = readFileSync(resolve(ROOT, 'src/sw-template.js'), 'utf8');
38:       const out = tpl.replace('__VERSION__', version).replace('__ASSETS__', JSON.stringify(['./', ...list.map((f) => './' + f)]));
39:       writeFileSync(join(outDir, 'sw.js'), out);
40:     },
41:   };
42: }
43: 
44: // 本番だけ、通信先を同一オリジンに制限する CSP を入れる
45: function cspPlugin(): Plugin {
46:   return {
47:     name: 'csp-meta',
48:     apply: 'build',
49:     transformIndexHtml(html) {
50:       const csp =
51:         "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; font-src 'self'; object-src 'none'; base-uri 'self'; form-action 'none'; frame-src 'none'";
52:       return html.replace('<meta charset="UTF-8" />', `<meta charset="UTF-8" />\n    <meta http-equiv="Content-Security-Policy" content="${csp}" />`);
