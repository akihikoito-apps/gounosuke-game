83:                 data = fileHandle.readData(ofLength: rangeLength)
84:                 headers["Accept-Ranges"] = "bytes"
85:                 headers["Content-Range"] = "bytes \(fromRange)-\(toRange)/\(totalSize)"
86:                 headers["Content-Length"] = String(data.count)
87:                 let response = HTTPURLResponse(url: localUrl, statusCode: 206, httpVersion: nil, headerFields: headers)
88:                 urlSchemeTask.didReceive(response!)
89:                 try fileHandle.close()
90:             } else {
91:                 if !stringToLoad.contains("cordova.js") {
92:                     if isMediaExtension(pathExtension: url.pathExtension) {
93:                         data = try Data(contentsOf: fileUrl, options: Data.ReadingOptions.mappedIfSafe)
94:                     } else {
95:                         data = try Data(contentsOf: fileUrl)
96:                     }
97:                 }
98:                 let urlResponse = URLResponse(url: localUrl, mimeType: mimeType, expectedContentLength: data.count, textEncodingName: nil)
99:                 let httpResponse = HTTPURLResponse(url: localUrl, statusCode: 200, httpVersion: nil, headerFields: headers)
100:                 if isMediaExtension(pathExtension: url.pathExtension) {
101:                     urlSchemeTask.didReceive(urlResponse)
102:                 } else {
103:                     urlSchemeTask.didReceive(httpResponse!)
104:                 }
105:             }
106:             urlSchemeTask.didReceive(data)
107:         } catch let error as NSError {
108:             urlSchemeTask.didFailWithError(error)
109:             return
110:         }
111:         urlSchemeTask.didFinish()
112:     }
113: 
114:     open func webView(_ webView: WKWebView, stop urlSchemeTask: WKURLSchemeTask) {
115:         urlSchemeTask.stopped = true
116:     }
117: 
118:     open func mimeTypeForExtension(pathExtension: String) -> String {
119:         if !pathExtension.isEmpty {
120:             if let uti = UTTypeCreatePreferredIdentifierForTag(kUTTagClassFilenameExtension, pathExtension as NSString, nil)?.takeRetainedValue() {
121:                 if let mimetype = UTTypeCopyPreferredTagWithClass(uti, kUTTagClassMIMEType)?.takeRetainedValue() {
122:                     return mimetype as String
123:                 }
124:             }
125:             // TODO: Remove in the future if Apple fixes the issue
126:             if let mimeType = mimeTypes[pathExtension] {
127:                 return mimeType
128:             }
129:             return "application/octet-stream"
130:         }
131:         return "text/html"
132:     }
133: 
134:     open func isMediaExtension(pathExtension: String) -> Bool {
135:         let mediaExtensions = ["m4v", "mov", "mp4",
136:                                "aac", "ac3", "aiff", "au", "flac", "m4a", "mp3", "wav"]
137:         if mediaExtensions.contains(pathExtension.lowercased()) {
138:             return true
139:         }
140:         return false
141:     }
142: 
143:     func handleCapacitorHttpRequest(_ urlSchemeTask: WKURLSchemeTask, _ localUrl: URL, _ isHttpsRequest: Bool) {
144:         var urlRequest = urlSchemeTask.request
145:         guard let url = urlRequest.url else { return }
146: 
147:         let urlComponents = URLComponents(url: url, resolvingAgainstBaseURL: false)
148:         if let targetUrl = urlComponents?.queryItems?.first(where: { $0.name == CapacitorBridge.httpInterceptorUrlParam })?.value,
149:            !targetUrl.isEmpty {
150:             urlRequest.url = URL(string: targetUrl)
151:         }
152: 
153:         let urlSession = URLSession.shared
154:         let task = urlSession.dataTask(with: urlRequest) { (data, response, error) in
155:             DispatchQueue.main.async {
156:                 guard !urlSchemeTask.stopped else { return }
157:                 if let error = error {
158:                     urlSchemeTask.didFailWithError(error)
159:                     return
160:                 }
161: 
162:                 if let response = response as? HTTPURLResponse {
163:                     let existingHeaders = response.allHeaderFields
164:                     var newHeaders: [AnyHashable: Any] = [:]
165: 
166:                     // Nothing should render this. If anything does, sandbox keeps it inert.
167:                     newHeaders["Content-Security-Policy"] = "sandbox; frame-ancestors 'none'"
168: 
169:                     // if using live reload, then set CORS headers
170:                     if self.isUsingLiveReload(url) {
171:                         newHeaders["Access-Control-Allow-Origin"] = self.serverUrl?.absoluteString ?? ""
172:                         newHeaders["Access-Control-Allow-Methods"] = "GET, HEAD, OPTIONS, TRACE"
173:                     }
174: 
175:                     if let mergedHeaders = existingHeaders.merging(newHeaders, uniquingKeysWith: { (_, newHeaders) in newHeaders }) as? [String: String] {
176: 
177:                         if let responseUrl = response.url {
178:                             if let modifiedResponse = HTTPURLResponse(
179:                                 url: responseUrl,
180:                                 statusCode: response.statusCode,
181:                                 httpVersion: nil,
182:                                 headerFields: mergedHeaders
183:                             ) {
184:                                 urlSchemeTask.didReceive(modifiedResponse)
185:                             }
186:                         }
187: 
188:                         if let data = data {
189:                             urlSchemeTask.didReceive(data)
190:                         }
191:                     }
192:                 }
193:                 urlSchemeTask.didFinish()
194:                 return
195:             }
196:         }
197: 
198:         task.resume()
199:     }
