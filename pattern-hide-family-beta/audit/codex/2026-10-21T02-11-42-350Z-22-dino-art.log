import type { SceneDef, CostumeDef } from '../scene';
import {
  ammoniteRock,
  cycadStump,
  eggShells,
  explorerCrate,
  fernCushion,
  footprintStone,
  geyserPool,
  ribArch,
  spottedEgg,
} from '../props-dino';

