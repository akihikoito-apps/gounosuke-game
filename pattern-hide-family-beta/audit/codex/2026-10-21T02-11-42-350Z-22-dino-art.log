    return import(pathToFileURL(cache).href);
  }
  try {
    mkdirSync(dirname(cache), { recursive: true });
    copyFileSync(out, cache);
  } catch {
    // 保存できなくても検査は続ける
  }
  return import(pathToFileURL(out).href);
}
