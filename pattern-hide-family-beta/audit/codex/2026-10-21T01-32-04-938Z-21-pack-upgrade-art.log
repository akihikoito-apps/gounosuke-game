  /** この部屋が開くクリア数（0：はじめから） */
  needCleared: number;
  /** パックの部屋：その背景で初めて友だちを見つけたら開く（友だちが仲間になるのと同じとき） */
  needScene?: SceneId;
  /** どのパックの中身か */
  content: ContentId;
  /** 置ける床の範囲（足もとの y）。これより上には置けない */
  floorTop: number;
  /** 奥（floorTop）と手前（1000）での大きさ */
  scaleBack: number;
  scaleFront: number;
}

