      const tuft = `<ellipse cx="0" cy="-195" rx="12" ry="14" fill="#FFF099" ${st}/><circle cx="0" cy="-195" r="5" fill="#FFFDF4"/>`;
      return (
        wing(-1) +
        wing(1) +
        `<ellipse cx="0" cy="-142" rx="48" ry="45" fill="${c.skin}" ${st}/>` +
        tuft +
        eyes() +
        cheeks() +
        `<path d="M-7 -125 Q0 -118 7 -125" fill="none" stroke="#3B2F35" stroke-width="3" stroke-linecap="round"/>`
      );
    }
    case 'popo': {
      const ear = (x: number) => `<circle cx="${x}" cy="-180" r="15" fill="${c.skin}" ${st}/><circle cx="${x}" cy="-179" r="8" fill="#F2D6D2"/>`;
      return (
        ear(-36) +
        ear(36) +
