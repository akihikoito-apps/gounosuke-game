// ローカル座標：足もと中央が原点、上が -y。高さ約200。
import { type Pt, type Shape, quadPoints, shapeToSvg } from './geometry';

export type CharacterId = 'koro' | 'mimi' | 'moko' | 'nyako' | 'popo' | 'ou' | 'choki' | 'pino' | 'puka' | 'hika' | 'gao';
