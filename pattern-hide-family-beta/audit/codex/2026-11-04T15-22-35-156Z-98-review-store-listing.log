## 作業後

- Codex の作業を `git add art && git commit` して、同じブランチに push してください。
- Claude 側では、画面写真・操作テスト・溶け込み具合を確認し、必要なら調整案を出します。
- 同じファイルを同時に複数のAIで編集しないため、Codex は `art/` だけ、Claude はそれ以外、と分けています。
// 将来の「追加パック（買い切り）」との境界。方針：strategy/MONETIZATION.md
// このベータでは課金を実装しない。ここにある値は購入の証明ではない。
// 本番で購入を扱う場合は、StoreKit / Google Play Billing など正規の決済経路の
// 検証結果だけを根拠にし、端末内のフラグ（localStorage等）を購入証明にしてはいけない。
import type { CharacterId } from '../core/characters';
import type { SceneId } from '../core/scene';

export type ContentId = `scene:${SceneId}` | `course:${number}` | `char:${CharacterId}` | 'trial:hardest' | `costume-pack:${string}` | `room:${string}`;

export type PackId = 'base' | 'more-courses' | 'beach' | 'forest' | 'aquarium' | 'night' | 'dino';

export interface PackDef {
  id: PackId;
  /** 保護者の画面などで使う名前 */
  name: string;
  /** 無料（最初から遊べる） */
  free: boolean;
  contents: ContentId[];
}

const courses = (from: number, to: number): ContentId[] => Array.from({ length: to - from + 1 }, (_, i) => `course:${from + i}` as ContentId);

/**
 * パックの一覧。どの中身も、ちょうど1つのパックに入る。
 * 基本（無料）には「最初のごほうび（コース1で仲間になる にゃこ）」まで必ず入れる。
 * 追加パックは、新しい背景＋新しい友だち＋シール、の形で足していく。
 */
export const PACKS: PackDef[] = [
  {
    id: 'base',
    name: 'きほん',
    free: true,
    // コース1・5で仲間になる にゃこ・ぽぽ は、無料の範囲のごほうび
    contents: ['scene:room', 'scene:garden', 'scene:shop', ...courses(1, 5), 'char:koro', 'char:mimi', 'char:moko', 'char:nyako', 'char:popo', 'room:living', 'room:treehouse'],
  },
  {
    id: 'more-courses',
    name: 'つづきの コース',
    free: false,
    contents: [...courses(6, 10), 'char:ou', 'trial:hardest', 'room:bedroom'],
  },
  {
    id: 'beach',
    name: 'うみべ パック',
    free: false,
    contents: ['scene:beach', 'char:choki', 'room:beach-deck'],
  },
  {
    id: 'forest',
    name: 'きのこの もり パック',
    free: false,
    contents: ['scene:forest', 'char:pino', 'room:yard'],
  },
  {
    id: 'aquarium',
    name: 'すいぞくかん パック',
    free: false,
    contents: ['scene:aquarium', 'char:puka', 'room:aquarium-room'],
  },
  {
    id: 'night',
    name: 'ほたるの かわべ パック',
    free: false,
    contents: ['scene:night', 'char:hika', 'room:veranda'],
  },
  {
    id: 'dino',
    name: 'きょうりゅうの たに パック',
    free: false,
    contents: ['scene:dino', 'char:gao', 'room:dino-land'],
  },
];

export function packOf(id: ContentId): PackDef | undefined {
  return PACKS.find((p) => p.contents.includes(id));
}

export interface EntitlementSource {
  /** 'beta-all-unlocked' はベータの全開放であり、購入状態ではない */
  readonly kind: 'beta-all-unlocked';
  canPlay(id: ContentId): boolean;
}

/**
 * 持っているパックだけ遊べる（ご本人の方針 2026-10-15：課金したもの・進捗で開いたものだけ）。
 * owned は将来 StoreKit の購入確認の結果だけを根拠にする。無料（きほん）はいつも遊べる。どのパックにも入っていない中身は遊べない。
 */
export function packEntitlements(owned: () => readonly PackId[]): { kind: 'packs'; canPlay(id: ContentId): boolean } {
  return {
    kind: 'packs',
    canPlay(id: ContentId) {
      const p = packOf(id);
      return !!p && (p.free || owned().includes(p.id));
    },
  };
}

export const betaEntitlements: EntitlementSource = {
  kind: 'beta-all-unlocked',
  canPlay: () => true,
};
