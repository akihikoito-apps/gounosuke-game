  69:   private mount(html: string): void {
  70:     this.el?.remove();
  71:     const el = document.createElement('div');
  72:     el.className = 'parent-layer';
  73:     el.innerHTML = html;
  74:     document.body.appendChild(el);
  75:     this.el = el;
  76:     document.removeEventListener('keydown', this.keyHandler);
  77:     document.addEventListener('keydown', this.keyHandler);
  78:     el.querySelector<HTMLElement>('[data-autofocus]')?.focus({ preventScroll: true });
  79:   }
  80: 
  81:   private trapFocus(e: KeyboardEvent): void {
  82:     const f = Array.from(this.el!.querySelectorAll<HTMLElement>('button:not([disabled]), input, [tabindex="0"]'));
  83:     if (f.length === 0) return;
  84:     const first = f[0];
  85:     const last = f[f.length - 1];
  86:     if (e.shiftKey && document.activeElement === first) {
  87:       e.preventDefault();
  88:       last.focus();
  89:     } else if (!e.shiftKey && document.activeElement === last) {
  90:       e.preventDefault();
  91:       first.focus();
  92:     }
  93:   }
