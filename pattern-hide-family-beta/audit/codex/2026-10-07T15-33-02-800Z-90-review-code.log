   1: // 端末内保存のスキーマ。子どもの氏名・誕生日・写真・音声・端末IDは持たない。
   2: import { CHARACTER_IDS, type CharacterId } from '../core/characters';
   3: import type { Difficulty, Placement } from '../core/placement';
   4: import type { SceneId } from '../core/scene';
