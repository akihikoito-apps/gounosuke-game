 124:   private onKey(n: number): void {
 125:     if (performance.now() < this.cooldownUntil) return; // 連打対策（保護者向け画面のみ）
 126:     const want = this.challenge.slice().sort((a, b) => a - b);
 127:     const next = want[this.progress.length];
 128:     if (n !== next) {
 129:       // 失敗：問題を作り直す（待ち時間・罰はない）
 130:       this.failures++;
 131:       if (this.failures % 3 === 0) this.cooldownUntil = performance.now() + 3000;
 132:       this.challenge = makeChallenge();
 133:       this.progress = [];
 134:       this.mount(this.gateHtml(this.failures % 3 === 0 ? 'ちがいました。少し待ってから、新しい問題でもう一度どうぞ。' : 'ちがいました。新しい問題です。'));
 135:       this.bindGate();
 136:       return;
 137:     }
 138:     this.progress.push(n);
 139:     this.el!.querySelector(`[data-key="${n}"]`)?.classList.add('on');
 140:     if (this.progress.length === 3) this.showHold();
 141:   }
 142: 
 143:   private showHold(): void {
 144:     const el = this.el!;
 145:     el.querySelectorAll<HTMLButtonElement>('[data-key]').forEach((b) => (b.disabled = true));
 146:     const box = el.querySelector<HTMLElement>('.gate-hold')!;
 147:     box.hidden = false;
 148:     const hold = el.querySelector<HTMLButtonElement>('[data-hold]')!;
 149:     hold.focus();
 150:     const startHold = (e: Event) => {
 151:       e.preventDefault();
 152:       hold.classList.add('holding');
 153:       window.clearTimeout(this.holdTimer);
 154:       this.holdTimer = window.setTimeout(() => this.openPanel(), HOLD_MS);
 155:     };
 156:     const stopHold = () => {
 157:       hold.classList.remove('holding');
 158:       window.clearTimeout(this.holdTimer);
 159:     };
 160:     hold.addEventListener('pointerdown', startHold);
 161:     hold.addEventListener('pointerup', stopHold);
 162:     hold.addEventListener('pointerleave', stopHold);
 163:     hold.addEventListener('pointercancel', stopHold);
 164:     hold.addEventListener('contextmenu', (e) => e.preventDefault());
 165:     hold.addEventListener('keydown', (e) => {
 166:       if ((e.key === 'Enter' || e.key === ' ') && !e.repeat) startHold(e);
 167:     });
 168:     hold.addEventListener('keyup', (e) => {
 169:       if (e.key === 'Enter' || e.key === ' ') stopHold();
 170:     });
 171:   }
