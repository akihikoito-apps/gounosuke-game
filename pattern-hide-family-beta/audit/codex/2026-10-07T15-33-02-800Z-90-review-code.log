  24: export interface PlaytestCounters {
  25:   searchStarted: number;
  26:   searchCompleted: number;
  27:   hintsUsed: number;
  28:   hideRounds: number;
  29:   /** 1回のプレイ時間のおおまかな区分（秒は残さない） */
  30:   durationUnder1m: number;
  31:   duration1to3m: number;
  32:   durationOver3m: number;
  33: }
  34: 
  35: export interface SaveData {
  36:   schema: typeof SCHEMA_VERSION;
  37:   settings: Settings;
  38:   resume: ResumeState | null;
  39:   playtest: { enabled: boolean; counters: PlaytestCounters };
  40: }
  41: 
  42: export const COUNTER_MAX = 9999;
  43: 
  44: export function emptyCounters(): PlaytestCounters {
  45:   return { searchStarted: 0, searchCompleted: 0, hintsUsed: 0, hideRounds: 0, durationUnder1m: 0, duration1to3m: 0, durationOver3m: 0 };
  46: }
  47: 
  48: export function defaults(): SaveData {
  49:   return {
  50:     schema: SCHEMA_VERSION,
  51:     settings: { sound: true, difficulty: 'easy', tutorialSeen: false },
  52:     resume: null,
  53:     playtest: { enabled: false, counters: emptyCounters() },
  54:   };
