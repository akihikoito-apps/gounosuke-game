 116:   private bindGate(): void {
 117:     const el = this.el!;
 118:     el.querySelector('[data-close]')?.addEventListener('click', () => this.close());
 119:     el.querySelectorAll<HTMLButtonElement>('[data-key]').forEach((b) =>
 120:       b.addEventListener('click', () => this.onKey(Number(b.dataset.key))),
 121:     );
 122:   }
