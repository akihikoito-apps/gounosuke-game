 403:   private onClick(e: MouseEvent): void {
 404:     const el = (e.target as HTMLElement).closest<HTMLElement>('[data-action]');
 405:     if (!el || !this.root.contains(el) || (el as HTMLButtonElement).disabled) return;
 406:     if (performance.now() < this.navLockUntil) return;
 407:     const a = el.dataset.action as string;
 408:     play('pop');
 409:     switch (a) {
 410:       case 'toSearch':
 411:         this.go('searchSetup');
 412:         break;
 413:       case 'toHide':
 414:         this.draft = emptyDraft();
 415:         this.multi = false;
 416:         this.go('hideScene');
 417:         break;
 418:       case 'resume':
 419:         this.resume();
 420:         break;
 421:       case 'parent':
 422:         this.parent.openGate(el);
 423:         break;
 424:       case 'home':
 425:         this.saveResume();
 426:         this.session = null; // 続きは保存側だけに持つ（削除後に書き戻さない）
 427:         this.go('title');
 428:         break;
 429:       case 'diff': {
 430:         const d = el.dataset.diff as Difficulty;
 431:         this.store.update((x) => {
 432:           x.settings.difficulty = d;
 433:         });
 434:         this.render();
 435:         break;
 436:       }
 437:       case 'tutorial':
 438:         this.go('tutorial');
 439:         break;
 440:       case 'backFromTutorial':
 441:         this.go('searchSetup');
 442:         break;
 443:       case 'startSearch':
 444:         this.searchScene = el.dataset.scene as SceneId;
 445:         if (!this.store.data.settings.tutorialSeen) this.go('tutorial');
 446:         else this.startSearch();
 447:         break;
 448:       case 'tutorialDone':
 449:         this.store.update((x) => {
 450:           x.settings.tutorialSeen = true;
 451:         });
 452:         this.startSearch();
 453:         break;
 454:       case 'hint':
 455:         this.onHint();
 456:         break;
 457:       case 'again':
 458:         this.onAgain();
 459:         break;
 460:       case 'swap':
 461:         this.onSwap();
 462:         break;
 463:       case 'bye':
 464:         this.session = null;
 465:         this.clearResume();
 466:         this.go('bye');
 467:         break;
 468:       case 'hidePickScene':
 469:         this.draft = chooseScene(this.draft, el.dataset.scene as SceneId);
 470:         this.draft = setChars(this.draft, ['koro'], SCENES[this.draft.sceneId as SceneId]);
 471:         this.go('hideChars');
 472:         break;
 473:       case 'pickChar':
 474:         this.onPickChar(el.dataset.char as CharacterId);
 475:         break;
 476:       case 'toggleMulti':
 477:         this.multi = !this.multi;
 478:         if (!this.multi && this.draft.chars.length > 1) {
 479:           this.draft = setChars(this.draft, [this.draft.chars[0]], this.hideScene());
 480:         }
 481:         this.render();
 482:         break;
 483:       case 'charsNext':
 484:         this.draft = select(this.draft, this.draft.chars[0]);
 485:         this.go('hideCostume');
 486:         break;
 487:       case 'costumeTab':
 488:         this.draft = select(this.draft, el.dataset.char as CharacterId);
 489:         this.render();
 490:         break;
 491:       case 'pickCostume': {
 492:         const c = this.draft.selected ?? this.draft.chars[0];
 493:         this.draft = setCostume(this.draft, c, el.dataset.costume as string, this.hideScene());
 494:         this.render();
 495:         break;
 496:       }
 497:       case 'backToChars':
 498:         this.go('hideChars');
 499:         break;
 500:       case 'costumeNext': {
 501:         const firstUnplaced = this.draft.chars.find((c) => !this.draft.placed[c]) ?? this.draft.selected;
 502:         this.draft = select(this.draft, firstUnplaced ?? null);
 503:         this.go('hidePlace');
 504:         break;
 505:       }
 506:       case 'backToCostume':
 507:         this.go('hideCostume');
 508:         break;
 509:       case 'undo':
 510:         this.draft = undo(this.draft);
 511:         this.render();
 512:         break;
 513:       case 'hideDone':
 514:         this.onHideDone();
 515:         break;
 516:       case 'handoffBack':
 517:         this.session = null;
 518:         this.clearResume();
 519:         this.go('hidePlace');
 520:         break;
 521:       case 'ready':
 522:         this.onReady();
 523:         break;
 524:     }
 525:   }
 526: 
 527:   private hideScene(): SceneDef {
 528:     return SCENES[this.draft.sceneId as SceneId];
 529:   }
 530: 
 531:   private onPickChar(c: CharacterId): void {
 532:     const cur = this.draft.chars;
 533:     let next: CharacterId[];
 534:     if (!this.multi) next = [c];
 535:     else if (cur.includes(c)) next = cur.length > 1 ? cur.filter((x) => x !== c) : cur;
 536:     else next = [...cur, c].slice(0, 3);
 537:     this.draft = setChars(this.draft, next, this.hideScene());
 538:     this.render();
 539:   }
 540: 
 541:   private startSearch(): void {
 542:     const difficulty = this.store.data.settings.difficulty;
 543:     const scene = SCENES[this.searchScene];
 544:     const seed = (Date.now() ^ (++this.seedCounter * 2654435761)) >>> 0;
 545:     const placements = autoLayout(scene, difficulty, seed);
 546:     this.session = newSession(scene.id, difficulty, placements, 'search', Date.now());
 547:     record(this.store, { type: 'searchStarted' });
 548:     this.saveResume();
 549:     this.go('play');
 550:   }
 551: 
 552:   private onHint(): void {
 553:     if (!this.session) return;
 554:     this.session = nextHint(this.session);
 555:     record(this.store, { type: 'hint' });
 556:     play('soft');
 557:     this.refreshStage();
 558:   }
 559: 
 560:   private onAgain(): void {
 561:     const s = this.session;
 562:     if (!s) return this.go('title');
 563:     if (s.origin === 'search') {
 564:       this.searchScene = s.sceneId;
 565:       this.startSearch();
 566:     } else {
 567:       // 同じ人が もういちど かくす（同じキャラクター・服のまま、置き場所から）
 568:       this.draft = { ...this.draft, placed: {}, history: [], selected: this.draft.chars[0] ?? null };
 569:       this.session = null;
 570:       this.clearResume();
 571:       this.go('hidePlace');
 572:     }
 573:   }
 574: 
 575:   private onSwap(): void {
 576:     const s = this.session;
 577:     const sceneId = s?.sceneId ?? 'room';
 578:     this.session = null;
 579:     this.clearResume();
 580:     this.multi = false;
 581:     this.draft = setChars(chooseScene(emptyDraft(), sceneId), ['koro'], SCENES[sceneId]);
 582:     this.go('hideChars');
 583:   }
 584: 
 585:   private onHideDone(): void {
 586:     const scene = this.hideScene();
 587:     if (!allPlaced(this.draft)) return;
 588:     const placements = toPlacements(this.draft);
 589:     const check = validateLayout(scene, placements);
 590:     if (!check.ok) {
 591:       // 起こらない想定。安全側として置き直しに戻す。
 592:       console.warn('layout rejected', check.problems);
 593:       this.draft = { ...this.draft, placed: {}, history: [], selected: this.draft.chars[0] ?? null };
 594:       this.render();
 595:       return;
 596:     }
 597:     this.session = newSession(scene.id, 'normal', placements, 'hide', Date.now());
 598:     this.saveResume();
 599:     this.go('handoff', 700);
 600:   }
 601: 
 602:   private onReady(): void {
 603:     if (!this.session) return this.go('title');
 604:     record(this.store, { type: 'hideRound' });
 605:     record(this.store, { type: 'searchStarted' });
 606:     this.session = { ...this.session, startedAt: Date.now() };
 607:     this.go('play');
 608:   }
 609: 
 610:   private resume(): void {
 611:     const r = this.store.data.resume;
 612:     if (!r) return;
 613:     this.session = { ...newSession(r.sceneId, r.difficulty, r.placements, r.origin, Date.now()), found: r.found.slice() };
 614:     if (r.origin === 'hide') this.draft = draftFromPlacements(r.sceneId, r.placements);
 615:     if (isComplete(this.session)) {
 616:       this.session = null;
 617:       this.clearResume();
 618:       this.render();
 619:       return;
 620:     }
 621:     // 隠したあとの再開は、受け渡しの目隠し画面から
 622:     this.go(r.origin === 'hide' ? 'handoff' : 'play', r.origin === 'hide' ? 700 : 350);
 623:   }
 624: 
 625:   private saveResume(): void {
 626:     const s = this.session;
 627:     if (!s || isComplete(s)) return;
 628:     this.store.update((d) => {
 629:       d.resume = { sceneId: s.sceneId, difficulty: s.difficulty, placements: s.placements, found: s.found, origin: s.origin };
 630:     });
 631:   }
 632: 
 633:   private clearResume(): void {
 634:     if (this.store.data.resume) {
 635:       this.store.update((d) => {
 636:         d.resume = null;
 637:       });
 638:     }
 639:   }
