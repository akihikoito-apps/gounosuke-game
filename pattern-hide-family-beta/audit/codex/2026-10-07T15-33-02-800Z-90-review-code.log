   1: // 試遊用の最小集計。既定OFF。端末外へは送らない（送信処理そのものが無い）。
   2: import type { Store } from './storage';
   3: import { COUNTER_MAX, type PlaytestCounters, emptyCounters } from './schema';
   4: 
   5: export type PlaytestEvent =
   6:   | { type: 'searchStarted' }
   7:   | { type: 'searchCompleted'; durationMs: number }
   8:   | { type: 'hint' }
   9:   | { type: 'hideRound' };
  10: 
  11: export function record(store: Store, ev: PlaytestEvent): void {
  12:   if (!store.data.playtest.enabled) return;
  13:   store.update((d) => {
  14:     const c = d.playtest.counters;
  15:     const inc = (k: keyof PlaytestCounters) => {
  16:       c[k] = Math.min(COUNTER_MAX, c[k] + 1);
  17:     };
  18:     switch (ev.type) {
  19:       case 'searchStarted':
  20:         inc('searchStarted');
  21:         break;
  22:       case 'searchCompleted':
  23:         inc('searchCompleted');
  24:         if (ev.durationMs < 60_000) inc('durationUnder1m');
  25:         else if (ev.durationMs < 180_000) inc('duration1to3m');
  26:         else inc('durationOver3m');
  27:         break;
  28:       case 'hint':
  29:         inc('hintsUsed');
  30:         break;
  31:       case 'hideRound':
  32:         inc('hideRounds');
  33:         break;
  34:     }
  35:   });
  36: }
  37: 
  38: export function setEnabled(store: Store, enabled: boolean): void {
  39:   store.update((d) => {
  40:     d.playtest.enabled = enabled;
  41:     // OFF に戻したら集計も消す
  42:     if (!enabled) d.playtest.counters = emptyCounters();
  43:   });
  44: }
  45: 
  46: export function resetCounters(store: Store): void {
  47:   store.update((d) => {
  48:     d.playtest.counters = emptyCounters();
  49:   });
  50: }
