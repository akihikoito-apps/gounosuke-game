 641:   // ---------- 画面ごとのイベント ----------
 642: 
 643:   private bindScreen(): void {
 644:     const stage = this.root.querySelector<HTMLElement>('#stage');
 645:     if (stage && typeof ResizeObserver !== 'undefined') {
 646:       this.resizeObs = new ResizeObserver(() => {
 647:         const r = stage.getBoundingClientRect();
 648:         stage.classList.toggle('compact', Math.min(r.width, r.height) < 360);
 649:       });
 650:       this.resizeObs.observe(stage);
 651:     }
 652:     if (this.screen === 'play') this.bindPlay();
 653:     if (this.screen === 'hidePlace') this.bindPlace();
 654:   }
 655: 
 656:   private stageSvg(): SVGSVGElement | null {
 657:     return this.root.querySelector<SVGSVGElement>('#stage svg');
 658:   }
 659: 
 660:   private bindPlay(): void {
 661:     const stage = $(this.root, '#stage');
 662:     stage.addEventListener('pointerdown', (e) => this.onPlayPointer(e));
 663:     this.decorateStage();
 664:   }
 665: 
 666:   private decorateStage(): void {
 667:     const s = this.session;
 668:     if (!s) return;
 669:     const svg = this.stageSvg();
 670:     if (!svg) return;
 671:     if (this.justFound >= 0) svg.querySelector(`.char[data-index="${this.justFound}"]`)?.classList.add('just-found');
 672:     const h = currentHint(SCENES[s.sceneId], s);
 673:     if (h && h.level >= 2) svg.querySelector(`.char[data-index="${h.index}"]`)?.classList.add('wiggle');
 674:   }
 675: 
 676:   private refreshStage(): void {
 677:     if (this.screen !== 'play' || !this.session) return;
 678:     const stage = this.root.querySelector<HTMLElement>('#stage');
 679:     if (!stage) return;
 680:     stage.innerHTML = this.playSvg();
 681:     this.decorateStage();
 682:   }
 683: 
 684:   private onPlayPointer(e: PointerEvent): void {
 685:     if (!e.isPrimary || !this.session || isComplete(this.session)) return;
 686:     const now = performance.now();
 687:     if (now - this.lastTap < TAP_DEBOUNCE_MS) return;
 688:     this.lastTap = now;
 689:     const svg = this.stageSvg();
 690:     if (!svg) return;
 691:     const p = toScene(svg, e.clientX, e.clientY);
 692:     if (!p) return;
 693:     const scene = SCENES[this.session.sceneId];
 694:     const r = tap(scene, this.session, p);
 695:     if (r.foundIndex < 0) {
 696:       this.ripple(e.clientX, e.clientY);
 697:       return;
 698:     }
 699:     this.session = r.session;
 700:     this.justFound = r.foundIndex;
 701:     play('found');
 702:     if (isComplete(this.session)) {
 703:       record(this.store, { type: 'searchCompleted', durationMs: Date.now() - this.session.startedAt });
 704:       this.clearResume();
 705:       const delay = prefersReducedMotion() ? 300 : 1300;
 706:       this.refreshStage();
 707:       this.updateTargets();
 708:       const s = this.session;
 709:       window.setTimeout(() => {
 710:         if (this.session === s && this.screen === 'play') {
 711:           play('clear');
 712:           this.navLockUntil = performance.now() + 400;
 713:           this.render();
 714:         }
 715:       }, delay);
 716:     } else {
 717:       this.saveResume();
 718:       this.refreshStage();
 719:       this.updateTargets();
 720:     }
 721:   }
 722: 
 723:   private updateTargets(): void {
 724:     const s = this.session;
 725:     if (!s) return;
 726:     s.found.forEach((f, i) => {
 727:       const t = this.root.querySelector<HTMLElement>(`[data-target="${i}"]`);
 728:       if (t && f && !t.classList.contains('found')) {
 729:         t.classList.add('found');
 730:         t.insertAdjacentHTML('beforeend', `<span class="check">${ICONS.done}</span>`);
 731:         t.setAttribute('aria-label', `${CHARACTERS[s.placements[i].char].name} みつけた`);
 732:       }
 733:     });
 734:     const hb = this.root.querySelector<HTMLButtonElement>('[data-action="hint"]');
 735:     if (hb) hb.disabled = isComplete(s);
 736:   }
 737: 
 738:   /** 外れたときの、色の付かないやさしい波紋（罰ではない） */
 739:   private ripple(x: number, y: number): void {
 740:     if (prefersReducedMotion()) return;
 741:     const r = document.createElement('div');
 742:     r.className = 'ripple';
 743:     r.style.left = `${x}px`;
 744:     r.style.top = `${y}px`;
 745:     document.body.appendChild(r);
 746:     window.setTimeout(() => r.remove(), 500);
 747:   }
 748: 
 749:   // ----- 置く（ドラッグ／タップ→タップ） -----
 750: 
 751:   private bindPlace(): void {
 752:     this.root.querySelectorAll<HTMLElement>('[data-tray]').forEach((el) => {
 753:       el.addEventListener('pointerdown', (e) => this.beginDrag(e, el.dataset.tray as CharacterId, false));
 754:       // キーボード：Enter/Space で選ぶ
 755:       el.addEventListener('keydown', (e) => {
 756:         if (e.key === 'Enter' || e.key === ' ') {
 757:           e.preventDefault();
 758:           const c = el.dataset.tray as CharacterId;
 759:           this.draft = select(this.draft, c);
 760:           this.render();
 761:           this.root.querySelector<HTMLElement>(`[data-tray="${c}"]`)?.focus({ preventScroll: true });
 762:         }
 763:       });
 764:     });
 765:     const stage = $(this.root, '#stage');
 766:     stage.querySelectorAll<SVGGElement>('.candidate').forEach((g) => {
 767:       g.addEventListener('keydown', (e) => {
 768:         if (e.key === 'Enter' || e.key === ' ') {
 769:           e.preventDefault();
 770:           const c = this.draft.selected;
 771:           if (!c) return;
 772:           this.draft = placeOnSpot(this.draft, c, g.dataset.spot as string, this.hideScene());
 773:           this.render();
 774:           this.root.querySelector<HTMLElement>(`[data-tray="${c}"]`)?.focus({ preventScroll: true });
 775:         }
 776:       });
 777:     });
 778:     stage.addEventListener('pointerdown', (e) => {
 779:       if (!e.isPrimary) return;
 780:       const charEl = (e.target as Element).closest<SVGGElement>('.char');
 781:       if (charEl) {
 782:         this.beginDrag(e, charEl.dataset.char as CharacterId, true);
 783:         return;
 784:       }
 785:       this.beginDrag(e, null, true);
 786:     });
 787:   }
 788: 
 789:   private beginDrag(e: PointerEvent, char: CharacterId | null, fromScene: boolean): void {
 790:     if (!e.isPrimary || this.drag) return;
 791:     e.preventDefault();
 792:     if (char === null) {
 793:       // シーンの空き場所のタップ：選択中の子をそこへ
 794:       this.tapCleanup?.();
 795:       const screenAtStart = this.screen;
 796:       const done = () => {
 797:         window.removeEventListener('pointerup', onUp);
 798:         window.removeEventListener('pointercancel', onCancel);
 799:         this.tapCleanup = null;
 800:       };
 801:       const onUp = (ev: PointerEvent) => {
 802:         if (ev.pointerId !== e.pointerId) return;
 803:         done();
 804:         if (this.screen !== screenAtStart) return;
 805:         if (Math.hypot(ev.clientX - e.clientX, ev.clientY - e.clientY) > 24) return;
 806:         this.placeSelectedAt(ev.clientX, ev.clientY, (e.target as Element).closest<SVGGElement>('.candidate')?.dataset.spot);
 807:       };
 808:       const onCancel = (ev: PointerEvent) => {
 809:         if (ev.pointerId === e.pointerId) done();
 810:       };
 811:       this.tapCleanup = done;
 812:       window.addEventListener('pointerup', onUp);
 813:       window.addEventListener('pointercancel', onCancel);
 814:       return;
 815:     }
 816:     this.drag = { char, x0: e.clientX, y0: e.clientY, moved: false, pointerId: e.pointerId, ghost: null, fromScene };
 817:     const move = (ev: PointerEvent) => {
 818:       const d = this.drag;
 819:       if (!d || ev.pointerId !== d.pointerId) return;
 820:       if (!d.moved && Math.hypot(ev.clientX - d.x0, ev.clientY - d.y0) > 12) {
 821:         d.moved = true;
 822:         d.ghost = this.makeGhost(d.char);
 823:       }
 824:       if (d.ghost) {
 825:         d.ghost.style.transform = `translate(${ev.clientX}px, ${ev.clientY}px)`;
 826:       }
 827:     };
 828:     const up = (ev: PointerEvent) => {
 829:       const d = this.drag;
 830:       if (!d || ev.pointerId !== d.pointerId) return;
 831:       cleanup();
 832:       this.drag = null;
 833:       d.ghost?.remove();
 834:       if (d.moved) {
 835:         const svg = this.stageSvg();
 836:         const rect = svg?.getBoundingClientRect();
 837:         const inside = rect && ev.clientX >= rect.left && ev.clientX <= rect.right && ev.clientY >= rect.top && ev.clientY <= rect.bottom;
 838:         if (svg && inside) {
 839:           const p = toScene(svg, ev.clientX, ev.clientY);
 840:           if (p) {
 841:             this.draft = placeAt(select(this.draft, d.char), d.char, p, this.hideScene());
 842:             play('pop');
 843:           }
 844:         }
 845:         this.render();
 846:       } else {
 847:         // タップ：選ぶ（タップ→タップで置く）
 848:         this.draft = select(this.draft, d.char);
 849:         this.render();
 850:       }
 851:     };
 852:     const cancel = (ev: PointerEvent) => {
 853:       if (this.drag && ev.pointerId === this.drag.pointerId) this.cancelDrag();
 854:     };
 855:     const cleanup = () => {
 856:       window.removeEventListener('pointermove', move);
 857:       window.removeEventListener('pointerup', up);
 858:       window.removeEventListener('pointercancel', cancel);
 859:       this.dragCleanup = null;
 860:     };
 861:     this.dragCleanup = cleanup;
 862:     window.addEventListener('pointermove', move);
 863:     window.addEventListener('pointerup', up);
 864:     window.addEventListener('pointercancel', cancel);
 865:   }
 866: 
 867:   private dragCleanup: (() => void) | null = null;
 868:   private tapCleanup: (() => void) | null = null;
 869: 
 870:   private cancelDrag(): void {
 871:     this.tapCleanup?.();
 872:     if (!this.drag) return;
 873:     this.drag.ghost?.remove();
 874:     this.dragCleanup?.();
 875:     this.drag = null;
 876:   }
 877: 
 878:   private makeGhost(c: CharacterId): HTMLElement {
 879:     const scene = this.hideScene();
 880:     const spec = scene.costumes.find((x) => x.id === this.draft.costumes[c])!.spec;
 881:     const g = document.createElement('div');
 882:     g.className = 'ghost';
 883:     g.innerHTML = fullIcon(CHARACTERS[c], patternMarkup('ghost-p', spec), 'ghost-p');
 884:     document.body.appendChild(g);
 885:     return g;
 886:   }
 887: 
 888:   private placeSelectedAt(x: number, y: number, spotId?: string): void {
 889:     const c = this.draft.selected;
 890:     if (!c) return;
 891:     const scene = this.hideScene();
 892:     if (spotId) {
 893:       this.draft = placeOnSpot(this.draft, c, spotId, scene);
 894:     } else {
 895:       const svg = this.stageSvg();
 896:       if (!svg) return;
 897:       const p = toScene(svg, x, y);
 898:       if (!p) return;
 899:       this.draft = placeAt(this.draft, c, p, scene);
 900:     }
 901:     play('pop');
 902:     this.render();
 903:   }
 904: 
 905:   /** テスト用：現在の配置（座標はシーン座標） */
 906:   debugState(): unknown {
 907:     return {
 908:       screen: this.screen,
 909:       session: this.session,
 910:       draft: this.draft,
 911:       spots: this.session ? this.session.placements.map((p) => getSpot(SCENES[this.session!.sceneId], p.spot)).map((s) => ({ id: s.id, x: s.x, y: s.y })) : [],
 912:     };
 913:   }
 914: }
 915: 
 916: function draftFromPlacements(sceneId: SceneId, placements: Placement[]): HideDraft {
 917:   const d = emptyDraft();
 918:   d.sceneId = sceneId;
 919:   d.chars = placements.map((p) => p.char);
 920:   for (const p of placements) {
 921:     d.costumes[p.char] = p.costume;
 922:     d.placed[p.char] = p.spot;
 923:   }
 924:   d.selected = d.chars[0] ?? null;
 925:   return d;
 926: }
