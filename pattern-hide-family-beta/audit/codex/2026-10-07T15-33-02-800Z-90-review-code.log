  21: export class ParentArea {
  22:   private store: Store;
  23:   private onChange: () => void;
  24:   private el: HTMLElement | null = null;
  25:   private challenge: number[] = [];
  26:   private progress: number[] = [];
  27:   private holdTimer = 0;
  28:   private returnFocus: HTMLElement | null = null;
  29:   private confirmDelete = false;
  30:   private keyHandler = (e: KeyboardEvent) => {
  31:     if (e.key === 'Escape') this.close();
  32:     if (e.key === 'Tab' && this.el) this.trapFocus(e);
  33:   };
  34: 
  35:   private onCleared: () => void;
  36:   private failures = 0;
  37:   private cooldownUntil = 0;
  38: 
  39:   constructor(store: Store, onChange: () => void, onCleared: () => void = () => undefined) {
  40:     this.store = store;
  41:     this.onChange = onChange;
  42:     this.onCleared = onCleared;
  43:   }
  44: 
  45:   isOpen(): boolean {
  46:     return this.el !== null;
  47:   }
  48: 
  49:   openGate(from?: HTMLElement): void {
  50:     this.close();
  51:     this.returnFocus = from ?? null;
  52:     this.challenge = makeChallenge();
  53:     this.progress = [];
  54:     this.mount(this.gateHtml());
  55:     this.bindGate();
  56:   }
  57: 
  58:   close(): void {
  59:     window.clearTimeout(this.holdTimer);
  60:     if (!this.el) return;
  61:     this.el.remove();
  62:     this.el = null;
  63:     this.confirmDelete = false;
  64:     document.removeEventListener('keydown', this.keyHandler);
  65:     const back = this.returnFocus?.isConnected ? this.returnFocus : document.querySelector<HTMLElement>('[data-action="parent"]');
  66:     back?.focus?.({ preventScroll: true });
  67:   }
