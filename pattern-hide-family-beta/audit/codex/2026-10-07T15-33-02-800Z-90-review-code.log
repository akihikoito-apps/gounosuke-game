  57: const isObj = (v: unknown): v is Record<string, unknown> => typeof v === 'object' && v !== null && !Array.isArray(v);
  58: const isBool = (v: unknown): v is boolean => typeof v === 'boolean';
  59: const isDiff = (v: unknown): v is Difficulty => v === 'easy' || v === 'normal';
  60: 
  61: function validPlacement(sceneId: SceneId, v: unknown): v is Placement {
  62:   if (!isObj(v)) return false;
  63:   const scene = SCENES[sceneId];
  64:   return (
  65:     CHARACTER_IDS.includes(v.char as CharacterId) &&
  66:     typeof v.spot === 'string' &&
  67:     scene.spots.some((s) => s.id === v.spot) &&
  68:     typeof v.costume === 'string' &&
  69:     scene.costumes.some((c) => c.id === v.costume) &&
  70:     (v.variant === 'exact' || v.variant === 'soft')
  71:   );
  72: }
  73: 
  74: export function validateResume(v: unknown): ResumeState | null {
  75:   if (!isObj(v)) return null;
  76:   if (!SCENE_IDS.includes(v.sceneId as SceneId)) return null;
  77:   const sceneId = v.sceneId as SceneId;
  78:   if (!isDiff(v.difficulty)) return null;
  79:   if (v.origin !== 'search' && v.origin !== 'hide') return null;
  80:   if (!Array.isArray(v.placements) || v.placements.length < 1 || v.placements.length > 3) return null;
  81:   if (!v.placements.every((p) => validPlacement(sceneId, p))) return null;
  82:   if (!Array.isArray(v.found) || v.found.length !== v.placements.length || !v.found.every(isBool)) return null;
  83:   const chars = new Set((v.placements as Placement[]).map((p) => p.char));
  84:   const spots = new Set((v.placements as Placement[]).map((p) => p.spot));
  85:   if (chars.size !== v.placements.length || spots.size !== v.placements.length) return null;
  86:   return {
  87:     sceneId,
  88:     difficulty: v.difficulty,
  89:     origin: v.origin,
  90:     placements: (v.placements as Placement[]).map((p) => ({ char: p.char, spot: p.spot, costume: p.costume, variant: p.variant })),
  91:     found: (v.found as boolean[]).slice(),
  92:   };
  93: }
  94: 
  95: function validCount(v: unknown): number {
  96:   return typeof v === 'number' && Number.isInteger(v) && v >= 0 ? Math.min(v, COUNTER_MAX) : 0;
  97: }
  98: 
  99: /**
 100:  * 読み込んだ値を検証する。部分的に壊れていても、使える部分だけ残して既定値で補う。
 101:  * 返り値の repaired が true なら何かを直した。
 102:  */
 103: export function validate(raw: unknown): { data: SaveData; repaired: boolean } {
 104:   const d = defaults();
 105:   if (!isObj(raw) || raw.schema !== SCHEMA_VERSION) return { data: d, repaired: true };
 106:   let repaired = false;
 107:   const s = raw.settings;
 108:   if (isObj(s)) {
 109:     if (isBool(s.sound)) d.settings.sound = s.sound;
 110:     else repaired = true;
 111:     if (isDiff(s.difficulty)) d.settings.difficulty = s.difficulty;
 112:     else repaired = true;
 113:     if (isBool(s.tutorialSeen)) d.settings.tutorialSeen = s.tutorialSeen;
 114:     else repaired = true;
 115:   } else repaired = true;
 116:   if (raw.resume !== null && raw.resume !== undefined) {
 117:     const r = validateResume(raw.resume);
 118:     if (r) d.resume = r;
 119:     else repaired = true;
 120:   }
 121:   const p = raw.playtest;
 122:   if (isObj(p) && isBool(p.enabled) && isObj(p.counters)) {
 123:     d.playtest.enabled = p.enabled;
 124:     const c = p.counters;
 125:     for (const k of Object.keys(d.playtest.counters) as (keyof PlaytestCounters)[]) {
 126:       const v = validCount(c[k]);
 127:       if (v !== c[k]) repaired = true;
 128:       d.playtest.counters[k] = v;
 129:     }
 130:     // OFF のときは集計を持たない
 131:     if (!d.playtest.enabled) d.playtest.counters = emptyCounters();
 132:   } else if (p !== undefined) repaired = true;
 133:   return { data: d, repaired };
 134: }
