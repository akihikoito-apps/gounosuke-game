const fs=require('fs');
const {chromium}=require('@playwright/test');
(async()=>{
const browser=await chromium.launch();const page=await browser.newPage();
const data=p=>'data:image/svg+xml;base64,'+fs.readFileSync(p).toString('base64');
const layers=['back','over','minor','fore'].map(n=>data('art/scenes/beach/'+n+'.svg'));
const tiles=['plain','stripes','dots','check'].map(n=>data('art/patterns/beach-'+n+'.svg'));
const result=await page.evaluate(async({layers,tiles})=>{
const decode=async url=>{const i=new Image();i.src=url;await i.decode();return i;};
const ls=await Promise.all(layers.map(decode)),ts=await Promise.all(tiles.map(decode));
const c=document.createElement('canvas');c.width=1000;c.height=1000;const ctx=c.getContext('2d');
ctx.drawImage(ls[0],0,0,1000,1000);
const region=(index,size,draw)=>{const pat=ctx.createPattern(ts[index],'repeat');pat.setTransform(new DOMMatrix().scale(size/256));ctx.fillStyle=pat;ctx.beginPath();draw();ctx.fill();};
region(0,40,()=>ctx.rect(0,470,1000,530));region(1,40,()=>ctx.rect(30,250,300,404));region(2,44,()=>ctx.roundRect(600,440,380,214,6));region(3,48,()=>{ctx.moveTo(400,770);ctx.lineTo(900,770);ctx.lineTo(930,972);ctx.lineTo(370,972);ctx.closePath();});
for(const l of ls.slice(1))ctx.drawImage(l,0,0,1000,1000);
return c.toDataURL('image/png').split(',')[1];
},{layers,tiles});
fs.writeFileSync('art/scenes/beach/.review.png',Buffer.from(result,'base64'));await browser.close();
})();

