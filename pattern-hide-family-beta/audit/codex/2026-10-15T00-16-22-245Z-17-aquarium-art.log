export interface Seat {
  /** もの の足もとから見た、座る位置（足もとが来る所） */
  x: number;
  y: number;
}

export interface ItemDef {
  id: string;
  name: string;
  /** どのシールでもらえるか。null ははじめから持っている */
  sticker: string | null;
  /** パックを買った瞬間から使える物（sticker が null のとき）の所属パック中身 */
  content?: ContentId;
  /** 置いたときの横幅のめやす（ローカル座標。友だちの横幅は 約150） */
  w: number;
  /** 床に敷くもの（いつも いちばん奥に描く） */
  flat?: boolean;
  /** 座れる場所（ソファ・ベッド・ブランコ） */
  seats?: Seat[];
  motion?: Motion;
}

