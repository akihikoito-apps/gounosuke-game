const hedgeTop = (() => {
  const pts = [{ x: 0, y: 660 }];
  for (let x = 0; x <= 570; x += 57) pts.push({ x, y: x % 114 === 0 ? 300 : 278 });
  pts.push({ x: 570, y: 660 });
  return pts;
})();

const fence = (() => {
  const pts = [{ x: 570, y: 660 }];
  for (let x = 570; x < 1000; x += 40) {
    pts.push({ x, y: 380 }, { x: x + 20, y: 356 });
  }
  pts.push({ x: 1000, y: 380 }, { x: 1000, y: 660 });
  return pts;
})();

