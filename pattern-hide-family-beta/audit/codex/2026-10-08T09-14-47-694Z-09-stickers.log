    ng(f, `使えない形式 ${ext}（png / webp / svg のみ）`);
    continue;
  }
  if (size > MAX_FILE) ng(f, `大きすぎ ${(size / 1024).toFixed(0)}KB > ${MAX_FILE / 1024}KB`);
