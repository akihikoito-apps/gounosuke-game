1003:    const token = ++this.renderToken;
1004:    // すでに読み込み済みの絵だけなら、隠さずそのまま（選び直しや描き直しで入力を止めない）
1005:    if (hrefs.every((h) => readyImages.has(h))) return;
1006:    stage.classList.add('loading');
