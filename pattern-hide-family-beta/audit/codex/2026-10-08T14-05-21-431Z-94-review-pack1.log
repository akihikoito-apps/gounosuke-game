        `<path d="M${-40 * sx} -168 L${-39 * sx} -200 L${-20 * sx} -184 Z" fill="#F7C6CF"/>`;
      const whisk = (sx: number) =>
        `<path d="M${30 * sx} -130 L${54 * sx} -134 M${30 * sx} -124 L${54 * sx} -122" stroke="#6E6070" stroke-width="2" stroke-linecap="round"/>`;
      return (
        ear(1) +
