1010:      requestAnimationFrame(() => requestAnimationFrame(() => {
1011:        if (token === this.renderToken) stage.classList.remove('loading');
1012:      }));
1013:    };
1014:    Promise.all(hrefs.map(decodeImage)).then(reveal, reveal);
1015:  }
